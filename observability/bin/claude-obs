#!/bin/sh
# claude-obs: the local observability stack for Claude Code (Grafana, Tempo, Loki, Prometheus in one
# container, grafana/otel-lgtm), fed by Claude Code's own OpenTelemetry from every profile.
# Free and local only: every port is bound to 127.0.0.1, Grafana and the backends never phone home,
# no plugin is downloaded, and nothing leaves the machine.
#
#   claude-obs up [--quiet]       start (or replace an outdated) stack
#   claude-obs down               stop and remove the container (data is kept)
#   claude-obs status [--json]    container, health, ports, data size
#   claude-obs open [dashboard]   open Grafana (overview, traces, time, logs, errors, sessions, tools, explore)
#   claude-obs logs               the container's log
#   claude-obs backfill [--days N] [--profile P] [--dry-run]   replay transcripts as traces and events
#   claude-obs reset confirm      stop the stack and delete its data
#   claude-obs env [profile]      the telemetry environment a profile's settings get
set -u

HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(dirname "$HERE")
IMAGE=grafana/otel-lgtm:0.37.0
NAME=${CLAUDE_OBS_NAME:-claude-obs}  # another name runs a second stack, e.g. the docs demo
STACK_REV=4  # bump when stack/ changes in a way a running container must pick up

if [ -n "${CLAUDE_MODS_HOME:-}" ]; then MODS_HOME=$CLAUDE_MODS_HOME
elif [ -d "$HOME/.claude-shared" ]; then MODS_HOME=$HOME/.claude-shared
else MODS_HOME=$HOME/.claude-mods; fi
OBS=${CLAUDE_OBS_DIR:-$MODS_HOME/observability}
CFG=$OBS/config.json

cfg() { # cfg <key> <default>
  [ -f "$CFG" ] || { echo "$2"; return; }
  v=$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2], sys.argv[3]))
except Exception: print(sys.argv[3])' "$CFG" "$1" "$2" 2>/dev/null) || v=$2
  echo "${v:-$2}"
}
GRAFANA_PORT=$(cfg grafanaPort 3301)
OTLP_HTTP=$(cfg otlpHttpPort 4318)
OTLP_GRPC=$(cfg otlpGrpcPort 4317)
RETENTION_DAYS=$(cfg retentionDays 90)
URL="http://127.0.0.1:$GRAFANA_PORT"

say() { [ "${QUIET:-0}" = 1 ] || printf '%s\n' "$*"; }
die() { printf 'claude-obs: %s\n' "$*" >&2; exit 1; }

have_docker() {
  command -v docker >/dev/null 2>&1 || return 1
  docker info --format '{{.ServerVersion}}' >/dev/null 2>&1
}
docker_hint() {
  if ! command -v docker >/dev/null 2>&1; then
    case "$(uname -s)" in
      Darwin) echo "Docker is not installed. A free option: 'brew install colima docker && colima start' (or OrbStack / Docker Desktop)." ;;
      *) echo "Docker is not installed: install docker (or podman-docker) from your package manager." ;;
    esac
  else
    echo "Docker is installed but its daemon is not running (start Docker Desktop, OrbStack or 'colima start')."
  fi
}

running() { [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = true ]; }
label() { docker inspect -f "{{index .Config.Labels \"$1\"}}" "$NAME" 2>/dev/null; }
wanted_sig() { echo "$IMAGE|$STACK_REV|$GRAFANA_PORT|$OTLP_HTTP|$OTLP_GRPC|$RETENTION_DAYS|$(stack_hash)"; }
# dashboards are left out: Grafana re-reads them every 30s, so they are refreshed in place without a restart
stack_hash() { (cd "$ROOT/stack" && find . -type f ! -path './dashboards/*' | LC_ALL=C sort | xargs cat) | cksum | cut -d' ' -f1; }

grafana_ok() { curl -fsS -m 2 "$URL/api/health" >/dev/null 2>&1; }
otlp_ok() { curl -sS -m 2 -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d '{}' "http://127.0.0.1:$OTLP_HTTP/v1/logs" 2>/dev/null | grep -q '^2'; }

# The stack's files are copied out of the plugin cache, so a plugin update never leaves a container
# mounting a deleted folder.
sync_stack() {
  mkdir -p "$OBS/data" "$OBS/stack"
  rm -rf "$OBS/stack.new" && cp -R "$ROOT/stack" "$OBS/stack.new" && rm -rf "$OBS/stack" && mv "$OBS/stack.new" "$OBS/stack"
}

# Into the folder the running container mounts (replacing the folder would leave it on the old one).
sync_dashboards() {
  d=$OBS/stack/dashboards
  [ -d "$d" ] || return 0
  for f in "$d"/*.json; do [ -e "$ROOT/stack/dashboards/${f##*/}" ] || rm -f "$f"; done
  cp "$ROOT"/stack/dashboards/*.json "$d/"
}

# Without a login you are a Viewer who can explore and try edits, but nothing is saved: a web page that
# posts to Grafana (CSRF) cannot change anything. Saving, data sources, plugins and users need the admin
# login, whose password is generated once, kept owner-only and handed to Grafana as a mounted file (never
# in a command line). Grafana only answers on the 127.0.0.1 hostname, so DNS rebinding cannot reach it.
PW=$OBS/admin-password
ensure_admin_password() {
  if [ ! -s "$PW" ]; then
    mkdir -p "$OBS"
    (umask 077 && LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24 >"$PW")
  fi
  chmod 600 "$PW" 2>/dev/null
}

# Grafana reads the admin password only when it creates its database: an older stack still has admin/admin.
rotate_default_admin() {
  printf '{"oldPassword":"admin","newPassword":"%s","confirmNew":"%s"}' "$(cat "$PW")" "$(cat "$PW")" |
    curl -fsS -m 5 -o /dev/null -u admin:admin -X PUT -H 'Content-Type: application/json' --data-binary @- \
      "$URL/api/user/password" 2>/dev/null && say "replaced Grafana's default admin password (now in $PW)"
  return 0
}

VERSION=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$ROOT/.claude-plugin/plugin.json" | head -1)
# true when dotted version $1 is newer than $2
ver_gt() { [ -n "$1" ] && [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)" = "$1" ]; }

ready() { grafana_ok && otlp_ok && docker exec "$NAME" test -f /tmp/ready 2>/dev/null; }
# waits up to $1 seconds for the stack to answer; fails at once if the container stops
wait_ready() {
  i=0
  while [ $i -lt "$1" ]; do
    ready && return 0
    running || return 2
    sleep 1; i=$((i + 1))
  done
  return 1
}

# Docker installed but its runtime stopped: start the one that is installed, and wait for it.
ensure_docker() {
  have_docker && return 0
  command -v docker >/dev/null 2>&1 || die "$(docker_hint)"
  if command -v colima >/dev/null 2>&1; then say "starting colima…"; colima start >/dev/null 2>&1
  elif [ -d /Applications/OrbStack.app ]; then say "starting OrbStack…"; open -ga OrbStack
  elif [ -d /Applications/Docker.app ]; then say "starting Docker Desktop…"; open -ga Docker
  else die "$(docker_hint)"; fi
  i=0
  until have_docker; do
    [ $i -ge 120 ] && die "$(docker_hint)"
    sleep 1; i=$((i + 1))
  done
}

# One `up` at a time across sessions and profiles; a lock left by a killed run expires after 10 minutes.
LOCK=$OBS/.up.lock
take_lock() {
  mkdir -p "$OBS"
  i=0
  while ! mkdir "$LOCK" 2>/dev/null; do
    if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rm -rf "$LOCK"; continue; fi
    [ $i -ge 600 ] && die "another 'claude-obs up' has held $LOCK for 10 minutes"
    sleep 1; i=$((i + 1))
  done
  trap 'rmdir "$LOCK" 2>/dev/null' EXIT
  trap 'rmdir "$LOCK" 2>/dev/null; exit 1' INT TERM
}

# What holds a port, when it is not our container: another container, or a process.
port_owner() {
  c=$(docker ps --filter "publish=$1" --format '{{.Names}}' 2>/dev/null | grep -vx "$NAME" | head -1)
  [ -n "$c" ] && { echo "container $c"; return; }
  command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | awk 'NR==2 {print $1 " (pid " $2 ")"}'
}
check_ports() {
  for p in "$GRAFANA_PORT" "$OTLP_HTTP" "$OTLP_GRPC"; do
    o=$(port_owner "$p")
    [ -n "$o" ] && die "port $p on 127.0.0.1 is taken by $o: stop it, or set grafanaPort/otlpHttpPort/otlpGrpcPort in $CFG"
  done
  return 0
}

# Brings the stack to this plugin's setup in any state: not there, stopped, running current, running an
# older setup (replaced), running a newer one from a profile already updated (kept: never downgraded),
# or running but not answering (restarted). Safe to run any number of times, from several sessions at once.
cmd_up() {
  ensure_docker
  take_lock
  sig=$(wanted_sig)
  if running; then
    have=$(label dev.claude-mods.version)
    if [ "$(label dev.claude-mods.sig)" = "$sig" ] || ver_gt "$have" "$VERSION"; then
      [ "$(label dev.claude-mods.sig)" = "$sig" ] && sync_dashboards
      if wait_ready 60; then
        if ver_gt "$have" "$VERSION"; then say "claude-obs $have is running (newer than this session's $VERSION): $URL"
        else say "claude-obs is running: $URL"; fi
        return 0
      fi
      say "claude-obs is not answering; restarting it…"
    fi
  fi
  docker rm -f "$NAME" >/dev/null 2>&1
  check_ports
  sync_stack
  ensure_admin_password
  docker image inspect "$IMAGE" >/dev/null 2>&1 || { say "pulling $IMAGE (once, ~1 GB)…"; docker pull -q "$IMAGE" >/dev/null || die "could not pull $IMAGE"; }
  ret_h=$((RETENTION_DAYS * 24))h
  S=$OBS/stack
  docker run -d --name "$NAME" --restart unless-stopped \
    --label "dev.claude-mods.sig=$sig" --label "dev.claude-mods.version=$VERSION" \
    -p "127.0.0.1:$GRAFANA_PORT:3000" -p "127.0.0.1:$OTLP_GRPC:4317" -p "127.0.0.1:$OTLP_HTTP:4318" \
    -v "$OBS/data:/data" \
    -v "$S/tempo.yaml:/otel-lgtm/tempo-config.yaml:ro" \
    -v "$S/loki.yaml:/otel-lgtm/loki-config.yaml:ro" \
    -v "$S/prometheus.yaml:/otel-lgtm/prometheus.yaml:ro" \
    -v "$S/pyroscope.yaml:/otel-lgtm/pyroscope-config.yaml:ro" \
    -v "$S/otelcol.yaml:/otel-lgtm/otelcol-config.yaml:ro" \
    -v "$S/provisioning/dashboards.yaml:/otel-lgtm/grafana/conf/provisioning/dashboards/grafana-dashboards.yaml:ro" \
    -v "$S/provisioning/datasources.yaml:/otel-lgtm/grafana/conf/provisioning/datasources/grafana-datasources.yaml:ro" \
    -v "$S/dashboards:/claude-obs/dashboards:ro" \
    -e "TEMPO_EXTRA_ARGS=-backend-worker.compaction.block-retention=$ret_h -backend-scheduler.provider.work.compaction.block-retention=$ret_h" \
    -e "LOKI_EXTRA_ARGS=-config.expand-env=true" -e "LOKI_RETENTION=$ret_h" \
    -e "PROMETHEUS_EXTRA_ARGS=--storage.tsdb.retention.time=${RETENTION_DAYS}d" \
    -e GF_AUTH_ANONYMOUS_ENABLED=true -e GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer -e GF_USERS_VIEWERS_CAN_EDIT=true \
    -v "$PW:/run/secrets/grafana-admin:ro" -e GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana-admin \
    -e GF_SERVER_DOMAIN=127.0.0.1 -e GF_SERVER_ENFORCE_DOMAIN=true -e "GF_SERVER_ROOT_URL=$URL/" \
    -e GF_ANALYTICS_REPORTING_ENABLED=false -e GF_ANALYTICS_CHECK_FOR_UPDATES=false \
    -e GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false -e GF_ANALYTICS_FEEDBACK_LINKS_ENABLED=false \
    -e GF_NEWS_NEWS_FEED_ENABLED=false -e GF_PLUGINS_PREINSTALL_DISABLED=true \
    -e GF_SECURITY_DISABLE_GRAVATAR=true -e GF_SNAPSHOTS_EXTERNAL_ENABLED=false \
    -e GF_USERS_DEFAULT_THEME=system -e GF_FEATURE_TOGGLES_ENABLE=traceqlEditor \
    -e GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/claude-obs/dashboards/overview.json \
    "$IMAGE" >/dev/null 2>"$OBS/.run.err" || {
      err=$(tail -c 300 "$OBS/.run.err"); docker rm -f "$NAME" >/dev/null 2>&1
      die "docker run failed: $err (set grafanaPort/otlpHttpPort/otlpGrpcPort in $CFG if a port is taken)"
    }
  say "starting claude-obs…"
  wait_ready 180; rc=$?
  [ $rc = 2 ] && die "the container stopped; 'claude-obs logs' shows why"
  [ $rc = 0 ] || { say "claude-obs is still starting; 'claude-obs status' to check"; return 0; }
  rotate_default_admin
  say "claude-obs is up: $URL"
}

cmd_down() {
  have_docker || die "$(docker_hint)"
  docker rm -f "$NAME" >/dev/null 2>&1 && say "claude-obs stopped (data kept in $OBS/data)" || say "claude-obs was not running"
}

cmd_status() {
  json=0; [ "${1:-}" = --json ] && json=1
  d=no; r=no; g=no; o=no; cur=no
  have_docker && d=yes
  if [ $d = yes ] && running; then r=yes; [ "$(label dev.claude-mods.sig)" = "$(wanted_sig)" ] && cur=yes; fi
  grafana_ok && g=yes
  otlp_ok && o=yes
  size=$(du -sh "$OBS/data" 2>/dev/null | cut -f1)
  if [ $json = 1 ]; then
    printf '{"docker":%s,"running":%s,"current":%s,"grafana":%s,"otlp":%s,"url":"%s","otlpHttp":%s,"otlpGrpc":%s,"data":"%s","dataSize":"%s","retentionDays":%s,"image":"%s"}\n' \
      "$([ $d = yes ] && echo true || echo false)" "$([ $r = yes ] && echo true || echo false)" "$([ $cur = yes ] && echo true || echo false)" \
      "$([ $g = yes ] && echo true || echo false)" "$([ $o = yes ] && echo true || echo false)" \
      "$URL" "$OTLP_HTTP" "$OTLP_GRPC" "$OBS/data" "${size:-0}" "$RETENTION_DAYS" "$IMAGE"
    return 0
  fi
  echo "docker:     $d$([ $d = no ] && echo " ($(docker_hint))")"
  echo "container:  $r$([ $r = yes ] && [ $cur = no ] && echo ' (outdated: claude-obs up replaces it)')"
  echo "grafana:    $g  $URL"
  echo "otlp:       $o  http://127.0.0.1:$OTLP_HTTP (grpc $OTLP_GRPC)"
  echo "data:       $OBS/data (${size:-empty}, kept $RETENTION_DAYS days)"
}

cmd_open() {
  case "${1:-overview}" in
    overview) p=/d/claude-overview ;;
    traces) p=/d/claude-traces ;;
    logs) p=/d/claude-logs ;;
    errors) p=/d/claude-errors ;;
    sessions|session) p=/d/claude-session ;;
    tools|hooks|mcp) p=/d/claude-tools ;;
    compare|vs|ab) p=/d/claude-compare ;;
    breakdown|events|ops) p=/d/claude-breakdown ;;
    time) p=/d/claude-time ;;
    explore) p=/explore ;;
    *) p=/d/claude-overview ;;
  esac
  (QUIET=1 cmd_up) || exit 1
  if command -v open >/dev/null 2>&1; then open "$URL$p"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL$p" >/dev/null 2>&1
  fi
  echo "$URL$p"
}

cmd_backfill() {
  case " $* " in *" -h "*|*" --help "*) ;; *) (QUIET=1 cmd_up) || exit 1 ;; esac
  python3 "$HERE/backfill.py" --endpoint "http://127.0.0.1:$OTLP_HTTP" --grafana "$URL" --dir "$OBS" --days "$RETENTION_DAYS" "$@" || return
  case " $* " in *" --dry-run "*|*" -h "*|*" --help "*) return ;; esac
  # old events sit in Loki's ingester, which queries skip for anything older than a few hours: flush them
  # to storage once the collector has passed them on
  have_docker || return 0
  sleep 10
  docker exec "$NAME" curl -s -X POST localhost:3100/flush >/dev/null 2>&1 && say "flushed to storage; everything is queryable now"
}

cmd_reset() {
  [ "${1:-}" = confirm ] || { echo "This deletes every trace, log and metric in $OBS/data. Run 'claude-obs reset confirm'."; return 1; }
  have_docker && docker rm -f "$NAME" >/dev/null 2>&1
  rm -rf "$OBS/data" "$OBS/backfill.json" && echo "claude-obs data deleted; 'claude-obs up' starts empty"
}

cmd_env() {
  prof=${1:-default}
  cat <<EOF
CLAUDE_CODE_ENABLE_TELEMETRY=1
CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:$OTLP_HTTP
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_METRICS_INCLUDE_VERSION=true
OTEL_RESOURCE_ATTRIBUTES=claude.profile=$prof
EOF
}

case "${1:-status}" in
  up) [ "${2:-}" = --quiet ] && QUIET=1; cmd_up ;;
  down|stop) cmd_down ;;
  status) shift; cmd_status "$@" ;;
  open) shift; cmd_open "$@" ;;
  logs) docker logs --tail 200 "$NAME" ;;
  backfill) shift; cmd_backfill "$@" ;;
  reset) shift; cmd_reset "$@" ;;
  env) shift; cmd_env "$@" ;;
  hint) have_docker && echo "Docker is running." || docker_hint ;;
  -h|--help|help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (claude-obs --help)" ;;
esac
