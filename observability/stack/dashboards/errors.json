{
 "uid": "claude-errors",
 "title": "Claude Code \u00b7 Errors",
 "description": "Where things fail: API errors and refusals, exhausted retries, tool failures, rejected permissions, MCP servers and hooks.",
 "tags": [
  "claude-code"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m",
   "15m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "profile",
    "label": "Profile",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "query_result(group by (claude_profile) (last_over_time(claude_obs_profile_last_session[90d])) or group by (claude_profile) (last_over_time(claude_code_session_count_total[90d])))",
     "refId": "profiles"
    },
    "definition": "query_result(group by (claude_profile) (last_over_time(claude_obs_profile_last_session[90d])) or group by (claude_profile) (last_over_time(claude_code_session_count_total[90d])))",
    "regex": "/claude_profile=\"(claude(?:-[^\"]+)?)\"/",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 1,
    "sort": 1,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "model",
    "label": "Model",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(claude_code_token_usage_tokens_total, model)",
     "refId": "model"
    },
    "definition": "label_values(claude_code_token_usage_tokens_total, model)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "API errors",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "enable": false,
    "iconColor": "red",
    "expr": "{service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_error\"}",
    "titleFormat": "API error {{status_code}}",
    "textFormat": "{{error}}",
    "tagKeys": "model,claude_profile"
   }
  ]
 },
 "links": [
  {
   "title": "Claude Code",
   "type": "dashboards",
   "tags": [
    "claude-code"
   ],
   "asDropdown": false,
   "includeVars": true,
   "keepTime": true
