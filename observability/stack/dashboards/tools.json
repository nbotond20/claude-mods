     },
     "expr": "sort_desc(topk(12, sum by (tool_name) (count_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} [$__range]))))",
     "legendFormat": "{{tool_name}}",
     "queryType": "instant"
    }
