{
 "uid": "claude-traces",
 "title": "Claude Code \u00b7 Traces & waterfall",
 "description": "Every prompt is a trace: claude_code.interaction with its model requests, tool runs (permission wait and execution), hooks and subagents. Click any trace to open its waterfall.",
 "tags": [
  "claude-code"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m",
   "15m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "profile",
    "label": "Profile",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": "label_values(claude_profile)",
    "definition": "label_values(claude_profile)",
    "regex": "/^claude(-.+)?$/",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "trace",
    "label": "Trace id",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "description": "Click a trace in a table to load its waterfall."
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "API errors",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "enable": false,
    "iconColor": "red",
    "expr": "{service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_error\"}",
    "titleFormat": "API error {{status_code}}",
    "textFormat": "{{error}}",
    "tagKeys": "model,claude_profile"
   }
  ]
 },
 "links": [
  {
   "title": "Claude Code",
   "type": "dashboards",
   "tags": [
    "claude-code"
   ],
   "asDropdown": false,
   "includeVars": true,
   "keepTime": true
  }
 ],
 "panels": [
  {
   "type": "table",
   "title": "Recent prompts (interactions)",
   "description": "Newest first. Duration is the whole turn.",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{name=\"claude_code.interaction\" && resource.claude.profile=~\"$profile\"} | select(span.user_prompt, span.interaction.sequence, span.session.id) with (most_recent=true)",
     "limit": 50,
     "tableType": "traces",
     "spss": 10
    }
   ],
   "transformations": [],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Trace ID"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open waterfall",
          "url": "/d/claude-traces?${__url_time_range}&${profile:queryparam}&var-trace=${__value.raw}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "traceIdHidden"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    },
    "sortBy": [
     {
      "displayName": "Start time",
      "desc": true
     }
    ]
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 10
   }
  },
  {
   "type": "table",
