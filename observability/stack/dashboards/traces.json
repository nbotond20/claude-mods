  {
   "type": "timeseries",
   "title": "Spans per minute by kind",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{claude_profile=~\"$profile\"}[$__rate_interval])) * 60",
     "legendFormat": "{{span_name}}",
     "instant": false,
     "range": true
    }
   ],
   "interval": "1m",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": true,
      "barAlignment": 1,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "axisSoftMin": 0,
      "lineInterpolation": "smooth",
      "insertNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean"
     ],
     "showLegend": true,
     "sortBy": "Mean",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 9,
