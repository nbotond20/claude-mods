      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | model=~\"$model\" | unwrap cache_read_tokens [$__range])) / (sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | model=~\"$model\" | unwrap cache_read_tokens [$__range])) + sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | model=~\"$model\" | unwrap input_tokens [$__range])) + sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | model=~\"$model\" | unwrap cache_creation_tokens [$__range])))",
     "legendFormat": "",
     "queryType": "instant"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "noValue": "0",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "decimals": 1
