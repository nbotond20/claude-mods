{
 "uid": "claude-overview",
 "title": "Claude Code \u00b7 Overview",
 "description": "Spend, volume, latency and errors across every profile. Filter by profile and model above.",
 "tags": [
  "claude-code"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m",
   "15m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "profile",
    "label": "Profile",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": "label_values(claude_profile)",
    "definition": "label_values(claude_profile)",
    "regex": "/^claude(-.+)?$/",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "model",
    "label": "Model",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(claude_code_token_usage_tokens_total, model)",
     "refId": "model"
    },
    "definition": "label_values(claude_code_token_usage_tokens_total, model)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "API errors",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "enable": false,
    "iconColor": "red",
    "expr": "{service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_error\"}",
    "titleFormat": "API error {{status_code}}",
    "textFormat": "{{error}}",
    "tagKeys": "model,claude_profile"
   }
  ]
 },
 "links": [
  {
   "title": "Claude Code",
   "type": "dashboards",
   "tags": [
    "claude-code"
   ],
   "asDropdown": false,
   "includeVars": true,
   "keepTime": true
  }
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Cost",
   "description": "List-price cost of every model request in the range.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | model=~\"$model\" | unwrap cost_usd [$__range]))",
     "legendFormat": "",
     "queryType": "instant"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "noValue": "0",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
