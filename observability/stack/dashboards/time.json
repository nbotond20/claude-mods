{
 "uid": "claude-time",
 "title": "Claude Code \u00b7 Where time goes",
 "description": "Wall-clock time split by what Claude Code was doing: waiting on the model, running tools, waiting on your permission, running hooks. From events (history included); panels marked live use span metrics.",
 "tags": [
  "claude-code"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m",
   "15m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "profile",
    "label": "Profile",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": "label_values(claude_profile)",
    "definition": "label_values(claude_profile)",
    "regex": "/^claude(-.+)?$/",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "API errors",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "enable": false,
    "iconColor": "red",
    "expr": "{service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_error\"}",
    "titleFormat": "API error {{status_code}}",
    "textFormat": "{{error}}",
    "tagKeys": "model,claude_profile"
   }
  ]
 },
 "links": [
  {
   "title": "Claude Code",
   "type": "dashboards",
   "tags": [
    "claude-code"
   ],
   "asDropdown": false,
   "includeVars": true,
   "keepTime": true
  }
 ],
 "panels": [
  {
   "type": "piechart",
   "title": "Time by activity",
   "description": "Summed durations of model requests, tool runs and questions Claude asked you. Subagents run in parallel, so this can exceed wall-clock time. Imported history (claude-obs backfill) cannot tell a permission prompt from the run itself, so its tool time includes those waits.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | unwrap duration_ms [$__range])) / 1000",
     "legendFormat": "model",
     "queryType": "instant"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} | tool_name!~\"AskUserQuestion|ExitPlanMode|EnterPlanMode\" | unwrap duration_ms [$__range])) / 1000",
     "legendFormat": "tools",
     "queryType": "instant"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} | tool_name=~\"AskUserQuestion|ExitPlanMode|EnterPlanMode\" | unwrap duration_ms [$__range])) / 1000",
     "legendFormat": "answering Claude",
     "queryType": "instant"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "model"
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "B"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "tools"
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "C"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "answering Claude"
       }
      ]
     }
    ]
   },
   "transformations": [],
   "options": {
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value",
      "percent"
     ],
     "showLegend": true
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "tooltip": {
     "mode": "single"
    },
    "displayLabels": []
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 10
   }
  },
  {
   "type": "bargauge",
   "title": "Tool execution time by tool",
   "description": "Imported history (claude-obs backfill) cannot tell a permission prompt from the run itself, so its tool time includes those waits.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sort_desc(topk(12, sum by (tool_name) (sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} | tool_name!~\"AskUserQuestion|ExitPlanMode|EnterPlanMode\" | unwrap duration_ms [$__range])) / 1000))",
     "legendFormat": "{{tool_name}}",
     "queryType": "instant"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "color": {
      "mode": "continuous-BlPu"
     },
     "displayName": ""
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "valueMode": "text",
    "showUnfilled": true,
    "namePlacement": "left",
    "sizing": "manual",
    "minVizHeight": 16,
    "maxVizHeight": 22,
    "text": {
     "titleSize": 12,
     "valueSize": 13
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/^Value/",
     "values": true
    }
   },
   "id": 2,
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 10
   }
  },
