  {
   "type": "timeseries",
   "title": "Time by activity over time",
   "description": "Imported history (claude-obs backfill) cannot tell a permission prompt from the run itself, so its tool time includes those waits.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | unwrap duration_ms [$__interval] offset -$__interval)) / 1000",
     "legendFormat": "model",
     "queryType": "range"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} | tool_name!~\"AskUserQuestion|ExitPlanMode|EnterPlanMode\" | unwrap duration_ms [$__interval] offset -$__interval)) / 1000",
     "legendFormat": "tools",
     "queryType": "range"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} | tool_name=~\"AskUserQuestion|ExitPlanMode|EnterPlanMode\" | unwrap duration_ms [$__interval] offset -$__interval)) / 1000",
     "legendFormat": "answering Claude",
     "queryType": "range"
    }
   ],
   "interval": "1m",
   "maxDataPoints": 90,
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 2,
      "fillOpacity": 80,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": true,
      "barAlignment": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "axisSoftMin": 0,
      "lineInterpolation": "smooth",
      "insertNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum"
     ],
     "showLegend": true,
     "sortBy": "Sum",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 4,
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 24,
    "h": 9
   }
  },
  {
   "type": "timeseries",
   "title": "Model time: waiting for first token vs generating",
   "description": "From api_request events: time to first token against the rest of the response.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | unwrap ttft_ms [$__interval] offset -$__interval)) / 1000",
     "legendFormat": "to first token",
     "queryType": "range"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | label_format gen=`{{ subf .duration_ms .ttft_ms }}` | unwrap gen [$__interval] offset -$__interval)) / 1000",
     "legendFormat": "generating",
     "queryType": "range"
    }
   ],
   "interval": "1m",
   "maxDataPoints": 90,
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 2,
      "fillOpacity": 80,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": true,
      "barAlignment": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "axisSoftMin": 0,
      "lineInterpolation": "smooth",
      "insertNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum"
     ],
     "showLegend": true,
     "sortBy": "Sum",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 8,
    "h": 9
   }
  },
  {
   "type": "timeseries",
   "title": "Average turn length (live)",
   "description": "Mean duration of a prompt from submit to the final answer. From span metrics: live sessions only.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(traces_spanmetrics_latency_sum{claude_profile=~\"$profile\", span_name=\"claude_code.interaction\"}[$__rate_interval])) / sum(rate(traces_spanmetrics_latency_count{claude_profile=~\"$profile\", span_name=\"claude_code.interaction\"}[$__rate_interval]))",
     "legendFormat": "mean turn",
     "instant": false,
     "range": true
    }
   ],
   "interval": "1m",
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": true,
      "barAlignment": 1,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "axisSoftMin": 0,
      "lineInterpolation": "smooth",
      "insertNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ],
     "showLegend": true,
     "sortBy": "Mean",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 6,
   "gridPos": {
    "x": 8,
    "y": 19,
    "w": 8,
    "h": 9
   }
  },
  {
   "type": "piechart",
   "title": "Live sessions: model, tools, you, hooks",
   "description": "From span metrics, live sessions only: adds time blocked on your permission (tool.blocked_on_user) and hooks.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (span_name) (increase(traces_spanmetrics_latency_sum{claude_profile=~\"$profile\", span_name=~\"claude_code.llm_request|claude_code.tool.execution|claude_code.tool.blocked_on_user|claude_code.hook\"}[$__range]))",
     "legendFormat": "{{span_name}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "options": {
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value",
      "percent"
     ],
     "showLegend": true
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/^Value/",
     "values": true
    },
    "tooltip": {
     "mode": "single"
    },
    "displayLabels": []
   },
   "id": 7,
   "gridPos": {
    "x": 16,
    "y": 19,
    "w": 8,
    "h": 9
   }
  },
  {
   "type": "table",
   "title": "Tools: count, total and tail latency",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "n",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (tool_name) (count_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} [$__range]))",
     "legendFormat": "",
     "queryType": "instant"
    },
    {
     "refId": "total",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (tool_name) (sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} | unwrap duration_ms [$__range])) / 1000",
     "legendFormat": "",
     "queryType": "instant"
    },
    {
     "refId": "p50",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "quantile_over_time(0.5, {service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} | unwrap duration_ms [$__range]) by (tool_name)",
     "legendFormat": "",
     "queryType": "instant"
    },
    {
     "refId": "p95",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "quantile_over_time(0.95, {service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} | unwrap duration_ms [$__range]) by (tool_name)",
     "legendFormat": "",
     "queryType": "instant"
    },
    {
     "refId": "fail",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (tool_name) (count_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"tool_result\"} | success=\"false\" [$__range]))",
     "legendFormat": "",
     "queryType": "instant"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "tool_name": "Tool",
       "Value #n": "Runs",
       "Value #total": "Total time",
       "Value #p50": "p50",
       "Value #p95": "p95",
       "Value #fail": "Failed"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Total time"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "basic",
         "valueDisplayMode": "text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "p50|p95"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Failed"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "text",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    },
    "sortBy": [
     {
      "displayName": "Total time",
      "desc": true
     }
    ]
   },
   "id": 8,
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 10
   }
  }
 ]
}
