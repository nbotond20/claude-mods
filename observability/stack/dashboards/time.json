     "expr": "sort_desc(topk(12, sum by (model) (sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | unwrap duration_ms [$__range])) / 1000))",
     "legendFormat": "{{model}}",
