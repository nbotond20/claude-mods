   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "valueMode": "text",
    "showUnfilled": true,
    "namePlacement": "left",
    "sizing": "manual",
    "minVizHeight": 16,
    "maxVizHeight": 22,
    "text": {
     "titleSize": 12,
     "valueSize": 13
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/^Value/",
