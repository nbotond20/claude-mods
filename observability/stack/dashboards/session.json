{
 "uid": "claude-session",
 "title": "Claude Code \u00b7 Session",
 "description": "One session end to end: its prompts as traces, spend, context growth and every event. Put a session id in the box (click one anywhere else).",
 "tags": [
  "claude-code"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m",
   "15m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "profile",
    "label": "Profile",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": "label_values(claude_profile)",
    "definition": "label_values(claude_profile)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "session",
    "label": "Session id",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "description": "A session id (from Overview, Traces or Logs); empty shows every session."
   },
   {
    "name": "trace",
    "label": "Trace id",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "description": "Click a trace in a table to load its waterfall."
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "API errors",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "enable": false,
    "iconColor": "red",
    "expr": "{service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_error\"}",
    "titleFormat": "API error {{status_code}}",
    "textFormat": "{{error}}",
    "tagKeys": "model,claude_profile"
   }
  ]
 },
 "links": [
  {
   "title": "Claude Code",
   "type": "dashboards",
   "tags": [
    "claude-code"
   ],
   "asDropdown": false,
   "includeVars": true,
   "keepTime": true
  }
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Cost",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | session_id=\"$session\" | unwrap cost_usd [$__range]))",
     "legendFormat": "",
     "queryType": "instant"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "noValue": "0",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "wideLayout": true,
    "showPercentChange": false
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
