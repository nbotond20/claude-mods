   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "table",
   "title": "Prompts in this session",
   "description": "Click a trace id to open its waterfall below.",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{name=\"claude_code.interaction\" && span.session.id=\"$session\"} | select(span.user_prompt, span.interaction.sequence) with (most_recent=true)",
     "limit": 200,
     "tableType": "traces",
     "spss": 10
    }
   ],
   "transformations": [],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Trace ID"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open waterfall",
          "url": "/d/claude-session?${__url_time_range}&${profile:queryparam}&${session:queryparam}&var-trace=${__value.raw}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "traceIdHidden"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    },
    "sortBy": [
     {
      "displayName": "Start time",
      "desc": true
     }
    ]
   },
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 9
   }
  },
  {
   "type": "traces",
   "title": "Waterfall: ${trace}",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "description": "Pick a prompt from the table above, or paste a trace id into the Trace id box.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "${trace}",
     "limit": 20
    }
   ],
   "options": {},
   "id": 8,
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 18
   }
  },
  {
   "type": "timeseries",
   "title": "Context per request",
   "description": "Input + cache tokens of each request: how full the context was.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "max(max_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | session_id=\"$session\" | label_format ctx=`{{ addf .input_tokens .cache_read_tokens .cache_creation_tokens }}` | unwrap ctx [$__interval] offset -$__interval))",
     "legendFormat": "context tokens",
     "queryType": "range"
    }
   ],
   "interval": "1m",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": true,
      "barAlignment": 1,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "axisSoftMin": 0,
      "lineInterpolation": "smooth",
      "insertNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max"
     ],
     "showLegend": true,
     "sortBy": "Max",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Cost over time",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", claude_profile=~\"$profile\", event_name=\"api_request\"} | session_id=\"$session\" | unwrap cost_usd [$__interval] offset -$__interval))",
     "legendFormat": "cost",
     "queryType": "range"
    }
   ],
   "interval": "1m",
   "maxDataPoints": 90,
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 2,
      "fillOpacity": 80,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": true,
      "barAlignment": 1,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "axisSoftMin": 0,
      "lineInterpolation": "smooth",
      "insertNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum"
     ],
     "showLegend": true,
     "sortBy": "Sum",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 10,
   "gridPos": {
    "x": 12,
    "y": 31,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "logs",
   "title": "Session events",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=~\"claude-code.*\"} | session_id=\"$session\" | line_format `{{.event_name | trimPrefix \"claude_code.\"}}{{with .model}} \u00b7 {{.}}{{end}}{{with .tool_name}} \u00b7 {{.}}{{end}}{{with .duration_ms}} \u00b7 {{.}}ms{{end}}{{with .cost_usd}} \u00b7 ${{.}}{{end}}{{if eq .success \"false\"}} \u00b7 FAILED{{end}}{{with .error}} \u00b7 {{.}}{{end}}{{with .prompt}} \u00b7 {{.}}{{end}}{{with .response}} \u00b7 {{.}}{{end}}{{with .tool_input}} \u00b7 {{.}}{{end}}`",
     "legendFormat": "",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "showLabels": false,
    "showCommonLabels": false,
    "wrapLogMessage": true,
    "prettifyLogMessage": false,
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "sortOrder": "Descending",
    "enableInfiniteScrolling": true
   },
   "id": 11,
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 24,
    "h": 18
   }
  }
 ]
}
