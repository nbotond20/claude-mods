#!/usr/bin/env python3
"""claude-usage: one SQLite database of every Claude Code profile's token spend.

Sources, all folded incrementally into <data>/usage.db (`claude-usage path` prints <data>):
  * every profile's transcripts   ~/.claude*/projects/**/*.jsonl  (incl. subagents/), plus any config
                                  dir a session ran from (registered by the mod) or listed in `profileDirs`
  * the usage-analytics mod's log <data>/events/**.jsonl
  * gateway spend                 <data>/gateway/key-<id>.json: what LiteLLM billed per day and model (the mod syncs it)
<data> is $CLAUDE_USAGE_DIR, else <mods home>/usage-analytics, where <mods home> is $CLAUDE_MODS_HOME,
else ~/.claude-shared if it exists, else ~/.claude-mods.

Commands:
  ingest  [--quiet] [--full]          fold new data in (lock-protected, incremental by byte offset)
  report  [what] [--days N] [--profile P[,P]] [--project S] [--limit N] [--ingest]
          what: overview (default) | profiles | daily | models | projects | tools | bash | files |
                agents | sessions | context | hours | cache | prompts | dialogs | gateway | quality | frustration | all
  sql     "SELECT ..."                run any query (tables: see `schema`)
  schema                              list tables and views
  export  TABLE|VIEW [--format csv|jsonl] [--out FILE]
  reprice                             recompute cost_usd after editing pricing.json
  serve   [--port N] [--daemon] [--open]      the web dashboard (127.0.0.1 only; port from config, default 8787)
  setup   [--json]                    what was detected (profiles, history, python, dashboard) for the setup wizard
  autostart on|off|status|sync        also keep the dashboard running from login (launchd on macOS, systemd on Linux)
  advise  [show|brief|record FILE|-|set ID STATUS|get ID|reproduce ID|due|notify|sql Q] [--json]
                                      the self-improving advisor: metrics, findings, recommendations and their verdicts
  recurring [show ID|brief|record FILE|-|set ID STATUS] [--days N] [--profile P] [--project X] [--min N] [--json]
                                      the prompts you keep typing: deterministic clusters, then labels and statuses
  path                                print the data directory
Only the Python standard library is used.
"""
import argparse, csv, fcntl, glob, json, os, re, sqlite3, sys, time
from datetime import datetime, timedelta, timezone

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import paths  # noqa: E402
import quality  # noqa: E402
import frustration  # noqa: E402

HOME = paths.HOME
DATA = paths.DATA
DB = os.path.join(DATA, 'usage.db')
PRICING = os.path.join(DATA, 'pricing.json')
SCHEMA_VERSION = 3

# USD per million tokens. cache write = 1.25x input (5 minute TTL) or 2x input (1 hour TTL) unless given.
DEFAULT_PRICING = {
    "_note": "USD per million tokens. Keys match as substrings of the model name, longest key first. "
             "Edit freely, then run `claude-usage reprice`.",
    "fast_multiplier": 2.0,
    "models": {
        "fable-5-1":  {"in": 10, "out": 50, "cache_read": 0.25},
        "fable-5":    {"in": 10, "out": 50, "cache_read": 0.25},
        "opus-5-5":   {"in": 4, "out": 20, "cache_read": 0.20},
        "opus-5":     {"in": 5, "out": 25},
        "opus-4-8":   {"in": 5, "out": 25},
        "opus-4-7":   {"in": 5, "out": 25},
        "opus-4-6":   {"in": 5, "out": 25},
        "opus-4-5":   {"in": 5, "out": 25},
        "opus-4-1":   {"in": 15, "out": 75},
        "opus-4":     {"in": 15, "out": 75},
        "sonnet-5-5": {"in": 2, "out": 10, "cache_read": 0.20},
        "sonnet-5":   {"in": 3, "out": 15},
        "sonnet-4":   {"in": 3, "out": 15},
        "haiku-5-5":  {"in": 0.10, "out": 0.50},
        "haiku-4-5":  {"in": 1, "out": 5},
        "haiku":      {"in": 0.80, "out": 4},
    },
}

DDL = """
CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
CREATE TABLE IF NOT EXISTS files (path TEXT PRIMARY KEY, kind TEXT, profile TEXT, size INTEGER, mtime REAL, offset INTEGER, lines INTEGER, ingested_at TEXT);
CREATE TABLE IF NOT EXISTS requests (
  msg_id TEXT PRIMARY KEY, request_id TEXT, profile TEXT, session_id TEXT, agent_id TEXT, is_sidechain INTEGER,
  ts TEXT, day TEXT, hour INTEGER, cwd TEXT, project TEXT, git_branch TEXT, version TEXT, entrypoint TEXT,
  model TEXT, effort TEXT, stop_reason TEXT, service_tier TEXT, speed TEXT, geo TEXT,
  input INTEGER, output INTEGER, cache_read INTEGER, cache_write INTEGER, cw_5m INTEGER, cw_1h INTEGER,
  thinking INTEGER, web_search INTEGER, web_fetch INTEGER, iterations INTEGER,
  text_chars INTEGER DEFAULT 0, thinking_blocks INTEGER DEFAULT 0, tool_blocks INTEGER DEFAULT 0, cost_usd REAL);
CREATE INDEX IF NOT EXISTS req_day ON requests(day);
CREATE INDEX IF NOT EXISTS req_session ON requests(session_id);
CREATE INDEX IF NOT EXISTS req_session_ts ON requests(session_id, ts);
CREATE TABLE IF NOT EXISTS tool_uses (
  id TEXT PRIMARY KEY, msg_id TEXT, profile TEXT, session_id TEXT, agent_id TEXT, ts TEXT, day TEXT, project TEXT,
  tool TEXT, input_chars INTEGER, file TEXT, ext TEXT, cmd TEXT, pattern TEXT, subagent TEXT, skill TEXT, mcp_server TEXT,
  detail TEXT, result_chars INTEGER, result_images INTEGER, is_error INTEGER, result_ts TEXT,
  verify TEXT, flag TEXT, lines_out INTEGER, wrote TEXT, replaced TEXT);
CREATE INDEX IF NOT EXISTS tool_msg ON tool_uses(msg_id);
CREATE INDEX IF NOT EXISTS tool_day ON tool_uses(day);
CREATE INDEX IF NOT EXISTS tool_session ON tool_uses(session_id);
CREATE TABLE IF NOT EXISTS prompts (uuid TEXT PRIMARY KEY, profile TEXT, session_id TEXT, agent_id TEXT, ts TEXT, day TEXT, project TEXT, kind TEXT, chars INTEGER, text TEXT);
CREATE TABLE IF NOT EXISTS attachments (uuid TEXT PRIMARY KEY, profile TEXT, session_id TEXT, agent_id TEXT, ts TEXT, day TEXT, type TEXT, chars INTEGER);
CREATE TABLE IF NOT EXISTS system_events (uuid TEXT PRIMARY KEY, profile TEXT, session_id TEXT, agent_id TEXT, ts TEXT, day TEXT, subtype TEXT, duration_ms INTEGER, message_count INTEGER, data TEXT);
CREATE TABLE IF NOT EXISTS sessions (
  session_id TEXT PRIMARY KEY, profile TEXT, cwd TEXT, project TEXT, git_branch TEXT, version TEXT, entrypoint TEXT,
  first_ts TEXT, last_ts TEXT, title TEXT, cc_cost_usd REAL, cc_api_ms INTEGER, cc_tool_ms INTEGER, cc_duration_ms INTEGER,
  lines_added INTEGER, lines_removed INTEGER);
CREATE TABLE IF NOT EXISTS agents (agent_id TEXT PRIMARY KEY, profile TEXT, session_id TEXT, agent_type TEXT, description TEXT, tool_use_id TEXT, parent_agent_id TEXT, spawn_depth INTEGER, shape TEXT);
CREATE TABLE IF NOT EXISTS events (src TEXT, line INTEGER, ts INTEGER, day TEXT, ev TEXT, sid TEXT, profile TEXT, data TEXT, PRIMARY KEY (src, line));
CREATE INDEX IF NOT EXISTS ev_ev ON events(ev, day);
CREATE INDEX IF NOT EXISTS prompt_session ON prompts(session_id, ts);
CREATE INDEX IF NOT EXISTS prompt_day ON prompts(day);
CREATE INDEX IF NOT EXISTS sys_day ON system_events(day);
CREATE INDEX IF NOT EXISTS att_day ON attachments(day);
CREATE TABLE IF NOT EXISTS git_outcomes (session_id TEXT PRIMARY KEY, checked_at TEXT, state TEXT, repos TEXT, files_edited INTEGER,
  files_committed INTEGER, lines_written INTEGER, lines_kept INTEGER, commits INTEGER);
CREATE TABLE IF NOT EXISTS gateway_spend (profile TEXT, day TEXT, model TEXT, spend_usd REAL, requests INTEGER, input INTEGER, output INTEGER,
  cache_read INTEGER, cache_write INTEGER, PRIMARY KEY (profile, day, model));
CREATE TABLE IF NOT EXISTS gateway_sync (key TEXT PRIMARY KEY, profile TEXT, profiles TEXT, host TEXT, synced_at TEXT, checked_at TEXT,
  error TEXT, last_day TEXT);

CREATE VIEW IF NOT EXISTS v_requests AS
  SELECT r.*, input + cache_read + cache_write AS context_tokens,
         COALESCE(a.agent_type, CASE WHEN r.agent_id IS NULL THEN 'main' ELSE 'subagent' END) AS agent_type
  FROM requests r LEFT JOIN agents a ON a.agent_id = r.agent_id;
CREATE VIEW IF NOT EXISTS v_mod_steps AS
  SELECT ts, day, profile, sid, json_extract(data,'$.turnId') turn_id, json_extract(data,'$.index') step,
         json_extract(data,'$.agentId') agent_id, json_extract(data,'$.model') model, json_extract(data,'$.effort') effort,
         json_extract(data,'$.messageCount') messages, json_extract(data,'$.usage.in') input, json_extract(data,'$.usage.out') output,
         json_extract(data,'$.usage.cr') cache_read, json_extract(data,'$.usage.cw') cache_write, json_extract(data,'$.stop') stop,
         json_extract(data,'$.ms') ms, json_extract(data,'$.ttftMs') ttft_ms, json_extract(data,'$.answerChars') answer_chars
  FROM events WHERE ev = 'step';
CREATE VIEW IF NOT EXISTS v_mod_tools AS
  SELECT ts, day, profile, sid, json_extract(data,'$.tool') tool, json_extract(data,'$.agentId') agent_id,
         json_extract(data,'$.ms') ms, json_extract(data,'$.inChars') in_chars, json_extract(data,'$.resultChars') result_chars,
         json_extract(data,'$.isError') is_error, json_extract(data,'$.denied') denied, json_extract(data,'$.file') file,
         json_extract(data,'$.cmd') cmd, json_extract(data,'$.contextChars') context_chars
  FROM events WHERE ev = 'tool';
CREATE VIEW IF NOT EXISTS v_context AS
  SELECT ts, day, profile, sid, json_extract(data,'$.why') why, json_extract(data,'$.totalTokens') total_tokens,
         json_extract(data,'$.rawMaxTokens') max_tokens, json_extract(c.value,'$.name') category,
         json_extract(c.value,'$.tokens') tokens, json_extract(c.value,'$.deferred') deferred
  FROM events, json_each(events.data, '$.categories') c WHERE ev = 'context';
CREATE VIEW IF NOT EXISTS v_measure AS
  SELECT ts, day, profile, sid, json_extract(data,'$.context.tokens') context_tokens, json_extract(data,'$.context.percent') context_pct,
         json_extract(data,'$.costUsd') cost_usd, json_extract(data,'$.rateLimits') rate_limits
  FROM events WHERE ev = 'measure';
CREATE VIEW IF NOT EXISTS v_compactions AS
  SELECT ts, day, profile, sid, json_extract(data,'$.trigger') trigger_, json_extract(data,'$.tokensBefore') tokens_before,
         json_extract(data,'$.tokensAfter') tokens_after, json_extract(data,'$.ms') ms, json_extract(data,'$.skipped') skipped
  FROM events WHERE ev = 'compact';
CREATE VIEW IF NOT EXISTS v_tool_schemas AS
  SELECT profile, json_extract(data,'$.tool') tool, MAX(json_extract(data,'$.chars')) chars,
         json_extract(data,'$.deferred') deferred, MAX(day) last_seen
  FROM events WHERE ev = 'tool_schema' GROUP BY profile, tool, deferred;
CREATE VIEW IF NOT EXISTS v_system_prompt AS
  SELECT ts, day, profile, sid, json_extract(data,'$.model') model, json_extract(data,'$.chars') chars,
         json_extract(s.value,'$.id') section, json_extract(s.value,'$.chars') section_chars
  FROM events, json_each(events.data, '$.sections') s WHERE ev = 'system_prompt';
-- Model spend that is not a person's own turn: the mods' own model calls (agents, the timesheet classifier) and claude -p / SDK runs.
CREATE VIEW IF NOT EXISTS v_background AS
  SELECT * FROM (SELECT r.msg_id, r.ts, r.day, r.profile, r.session_id, r.agent_id, r.project, r.model, r.cost_usd, r.output,
         r.input + r.cache_read + r.cache_write AS context_tokens,
         CASE WHEN r.cwd LIKE '%/.timesheet/classifier' THEN 'timesheet: classifier'
              WHEN a.agent_type GLOB '[a-z]*:*' AND substr(a.agent_type, 1, instr(a.agent_type, ':') - 1)
                   IN ('usage-analytics', 'budget-guard', 'timesheet', 'lean-tools', 'lsp-first', 'no-attribution') THEN a.agent_type END AS caller,
         CASE WHEN r.cwd LIKE '%/.timesheet/classifier' THEN 'claude -p' ELSE 'agent' END AS kind,
         COALESCE(r.agent_id, r.session_id) AS run_id
  FROM requests r LEFT JOIN agents a ON a.agent_id = r.agent_id) WHERE caller IS NOT NULL
  UNION ALL
  -- Calls a mod makes inside a session (no transcript of their own), from its impact events. budget-guard's Haiku
  -- classifier logs only its input size: priced at Haiku 5.5 list ($0.10 in, $0.50 out per Mtok), ~60 tokens of
  -- instructions and a 5-token answer on top. Keep-alive pings log their own cost.
  SELECT e.src || ':' || e.line, strftime('%Y-%m-%dT%H:%M:%fZ', e.ts / 1000.0, 'unixepoch'), e.day, e.profile, e.sid, NULL, s.project,
         json_extract(e.data, '$.model'),
         CASE json_extract(e.data, '$.kind') WHEN 'keepalive' THEN json_extract(e.data, '$.costUsd')
              ELSE ((COALESCE(json_extract(e.data, '$.inputChars'), 0) / 4.0 + 60) * 0.10 + 5 * 0.50) / 1e6 END,
         COALESCE(json_extract(e.data, '$.output'), 5),
         CASE json_extract(e.data, '$.kind') WHEN 'keepalive' THEN json_extract(e.data, '$.tokens')
              ELSE CAST(COALESCE(json_extract(e.data, '$.inputChars'), 0) / 4 + 60 AS INTEGER) END,
         json_extract(e.data, '$.mod') || CASE json_extract(e.data, '$.kind') WHEN 'keepalive' THEN ': keep-alive pings'
              ELSE ': Haiku classifier (' || COALESCE(json_extract(e.data, '$.purpose'), '?') || ')' END,
         'in-session call', e.src || ':' || e.line
  FROM events e LEFT JOIN sessions s ON s.session_id = e.sid
  WHERE e.ev = 'mod' AND json_extract(e.data, '$.kind') IN ('classify', 'keepalive');
CREATE VIEW IF NOT EXISTS v_mod_actions AS
  SELECT ts, day, profile, sid, json_extract(data,'$.mod') mod, json_extract(data,'$.kind') kind, json_extract(data,'$.arm') arm,
         json_extract(data,'$.nudge') nudge, json_extract(data,'$.chars') chars, json_extract(data,'$.bytesAll') bytes_all,
         json_extract(data,'$.bytesKept') bytes_kept, json_extract(data,'$.followed') followed, json_extract(data,'$.total') total, data
  FROM events WHERE ev = 'mod';
-- Mod dialogs: what each mod asked the person and what they answered, mod command replies, held prompts and toasts;
-- budget-guard's band choice on a held new-task prompt is the hold's answer.
CREATE VIEW IF NOT EXISTS v_dialogs AS
  SELECT ts, day, profile, sid, strftime('%Y-%m-%d %H:%M:%S', ts / 1000.0, 'unixepoch', 'localtime') at,
         json_extract(data,'$.mod') mod, json_extract(data,'$.kind') kind, COALESCE(json_extract(data,'$.via'), 'mod') via,
         json_extract(data,'$.command') command, json_extract(data,'$.header') header, json_extract(data,'$.question') question,
         json_extract(data,'$.options') options, json_extract(data,'$.answer') answer, json_extract(data,'$.reply') reply,
         COALESCE(json_extract(data,'$.dismissed'), 0) dismissed, json_extract(data,'$.ms') ms
  FROM events WHERE ev = 'dialog'
  UNION ALL
  SELECT ts, day, profile, sid, strftime('%Y-%m-%d %H:%M:%S', ts / 1000.0, 'unixepoch', 'localtime'),
         json_extract(data,'$.mod'), 'hold_answer', 'band', NULL, 'new task', 'Clear, compact or keep the held prompt?',
         '["clear","compact","keep"]', json_extract(data,'$.how'), NULL, 0, NULL
  FROM events WHERE ev = 'mod' AND json_extract(data,'$.kind') = 'resolve';
"""


def log(args, *a):
    if not getattr(args, 'quiet', False):
        print(*a, file=sys.stderr)


def connect():
    os.makedirs(DATA, exist_ok=True)
    con = sqlite3.connect(DB, timeout=60)
    con.execute('PRAGMA journal_mode=WAL')
    con.execute('PRAGMA synchronous=NORMAL')
    drop_old_views(con)
    con.executescript(DDL)
    con.executescript(frustration.DDL)
    migrate(con)
    con.execute("INSERT OR REPLACE INTO meta VALUES ('schema_version', ?)", (str(SCHEMA_VERSION),))
    return con


def drop_old_views(con):
    """Views are created only when missing: drop them when the schema changed so DDL makes them again."""
    try:
        v = con.execute("SELECT v FROM meta WHERE k = 'schema_version'").fetchone()
    except sqlite3.OperationalError:
        return
    if v and int(v[0]) < SCHEMA_VERSION:
        for (name,) in con.execute("SELECT name FROM sqlite_master WHERE type = 'view'").fetchall():
            con.execute(f'DROP VIEW IF EXISTS "{name}"')


def migrate(con):
    """Bring a database from an earlier version up to this one; new columns are filled in by the next import."""
    have = {r[1] for r in con.execute('PRAGMA table_info(tool_uses)')}
    for col, kind in (('verify', 'TEXT'), ('flag', 'TEXT'), ('lines_out', 'INTEGER'), ('wrote', 'TEXT'), ('replaced', 'TEXT')):
        if col not in have:
            con.execute(f'ALTER TABLE tool_uses ADD COLUMN {col} {kind}')
    v = con.execute("SELECT v FROM meta WHERE k = 'schema_version'").fetchone()
    if v and int(v[0]) < 2:
        # 2: interrupts are their own kind, not prompts; checks, failure marks and written lines need one more pass
        con.execute("UPDATE prompts SET kind = 'interrupt' WHERE kind = 'prompt' AND text LIKE '[Request interrupted by user%'")
        con.execute("INSERT OR REPLACE INTO meta VALUES ('backfill_quality', '1')")
    con.commit()


def load_pricing():
    if not os.path.exists(PRICING):
        os.makedirs(DATA, exist_ok=True)
        with open(PRICING, 'w') as f:
            json.dump(DEFAULT_PRICING, f, indent=2)
    with open(PRICING) as f:
        p = json.load(f)
    models = sorted(p.get('models', {}).items(), key=lambda kv: -len(kv[0]))
    return models, float(p.get('fast_multiplier', 1))


def make_coster():
    models, fast = load_pricing()
    cache = {}

    def price(model):
        if model not in cache:
            m = (model or '').lower()
            cache[model] = next((v for k, v in models if k in m), None)
        return cache[model]

    def cost(model, speed, inp, out, cr, cw5, cw1, cw):
        p = price(model)
        if not p:
            return None
        i = p['in']
        c = (inp * i + out * p['out'] + cr * p.get('cache_read', i * 0.1)
             + cw5 * p.get('cache_write_5m', i * 1.25) + cw1 * p.get('cache_write_1h', i * 2)
             + max(0, cw - cw5 - cw1) * p.get('cache_write_5m', i * 1.25)) / 1e6
        return c * (fast if speed == 'fast' else 1)
    return cost


# Secrets that show up in commands, prompts and tool output are blanked before they reach the database.
SECRET_PATTERNS = [
    (re.compile(r'-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?(-----END [A-Z ]*PRIVATE KEY-----|$)'), '[REDACTED PRIVATE KEY]'),
    (re.compile(r'\b(sk-(?:ant-)?[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}'
                r'|xox[abprs]-[A-Za-z0-9-]{10,}|eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,})'), '[REDACTED]'),
    (re.compile(r'\b((?:bearer|basic|token)\s+)[A-Za-z0-9._~+/=-]{12,}', re.I), r'\1[REDACTED]'),
    (re.compile(r'''([A-Za-z0-9_-]*(?:token|secret|passw(?:or)?d|api[_-]?key|access[_-]?key|credential|authorization)[A-Za-z0-9_-]*'''
                r'''["']?\s*[:=]\s*["']?)(?![0-9.]+(?:\W|$))[^\s"',;&|}]{6,}''', re.I), r'\1[REDACTED]'),
    (re.compile(r'(://[^\s/:@]+:)[^\s/@]{3,}@'), r'\1[REDACTED]@'),
]
SECRET_KEY = re.compile(r'(token|secret|passw(or)?d|api[_-]?key|access[_-]?key|credential|authorization|cookie)$', re.I)


def redact(text):
    if not isinstance(text, str):
        return text
    for pat, by in SECRET_PATTERNS:
        text = pat.sub(by, text)
    return text


def scrub(v, key=''):
    if isinstance(v, str):
        return '[REDACTED]' if SECRET_KEY.search(key) and len(v) >= 6 else redact(v)
    if isinstance(v, list):
        return [scrub(x) for x in v]
    if isinstance(v, dict):
        return {k: scrub(x, k) for k, x in v.items()}
    return v


def local(ts):
    """ISO UTC timestamp -> (local day, local hour)."""
    try:
        d = datetime.fromisoformat(ts.replace('Z', '+00:00')).astimezone()
        return d.strftime('%Y-%m-%d'), d.hour
    except Exception:
        return None, None


def project_of(cwd):
    if not cwd:
        return None
    cwd = re.split(r'/\.claude/worktrees/|/\.worktrees/|-worktrees/|/worktrees/', cwd)[0]
    return cwd.replace(HOME, '~')


def size_of(x):
    if x is None:
        return 0
    return len(x) if isinstance(x, str) else len(json.dumps(x, ensure_ascii=False))


def result_size(content):
    """Characters of text and number of images in a tool_result's content."""
    if isinstance(content, str):
        return len(content), 0
    chars = imgs = 0
    for b in content or []:
        if isinstance(b, dict):
            if b.get('type') == 'image':
                imgs += 1
            else:
                chars += size_of(b.get('text') if 'text' in b else b)
    return chars, imgs


def result_text(content):
    if isinstance(content, str):
        return content
    return '\n'.join(b.get('text') or '' for b in content or [] if isinstance(b, dict) and b.get('type') == 'text')


def tool_facets(name, inp):
    inp = inp if isinstance(inp, dict) else {}
    s = lambda k: inp.get(k) if isinstance(inp.get(k), str) else None
    f = {'file': s('file_path') or s('notebook_path') or s('path'), 'ext': None, 'cmd': None, 'pattern': None,
         'subagent': None, 'skill': None, 'mcp_server': None, 'detail': None, 'verify': None}
    if f['file']:
        m = re.search(r'\.([A-Za-z0-9]+)$', f['file'])
        f['ext'] = m.group(1).lower() if m else None
    if name == 'Bash':
        cmd = s('command') or ''
        m = re.search(r'\{ (.*?)\n\} >"\$__(?:lt|bg)_log"', cmd, re.S)  # unwrap lean-tools / budget-guard output caps
        if m:
            cmd = m.group(1)
            f['detail'] = 'capped'
        words = cmd.strip().split()
        # skip env assignments and `cd x &&` prefixes to find the real program
        while words and ('=' in words[0] and not words[0].startswith('-')):
            words = words[1:]
        if len(words) >= 3 and words[0] == 'cd' and words[2] in ('&&', ';'):
            words = words[3:]
        elif len(words) >= 2 and words[0] == 'cd' and words[1].endswith(';'):
            words = words[2:]
        f['cmd'] = ' '.join(words[:2])[:80] or None
        f['verify'] = quality.verify_kind(cmd)
    elif name in ('Grep', 'Glob'):
        f['pattern'] = (s('pattern') or '')[:200]
        f['detail'] = s('output_mode') or s('glob')
    elif name in ('Agent', 'Task'):
        f['subagent'] = s('subagent_type') or 'general-purpose'
        f['detail'] = s('model')
    elif name == 'Skill':
        f['skill'] = s('skill')
    elif name == 'WebFetch':
        m = re.match(r'https?://([^/]+)', s('url') or '')
        f['detail'] = m.group(1) if m else None
    elif name == 'WebSearch':
        f['detail'] = (s('query') or '')[:200]
    elif name == 'LSP':
        f['detail'] = s('operation')
    elif name == 'Read':
        f['detail'] = json.dumps({k: inp[k] for k in ('offset', 'limit', 'pages') if k in inp}) if any(k in inp for k in ('offset', 'limit', 'pages')) else None
    elif name == 'Edit':
        f['detail'] = 'replace_all' if inp.get('replace_all') else None
    if name.startswith('mcp__'):
        f['mcp_server'] = name.split('__')[1] if name.count('__') >= 2 else None
    return f


def prompt_kind(text, is_meta, sidechain_root):
    if sidechain_root:
        return 'agent_prompt'
    if is_meta:
        return 'meta'
    t = text.lstrip()
    if t.startswith('[Request interrupted by user'):
        return 'interrupt'
    if t.startswith('<command-name>') or t.startswith('<command-message>'):
        return 'command'
    if t.startswith('<local-command-stdout>') or t.startswith('<local-command-stderr>'):
        return 'command_output'
    if t.startswith('<bash-input>') or t.startswith('<bash-stdout>'):
        return 'shell'
    if t.startswith('<task-notification>') or t.startswith('<system-reminder>'):
        return 'notification'
    if t.startswith('This session is being continued') or t.startswith('Summary:'):
        return 'compact_summary'
    return 'prompt'


class Ingest:
    def __init__(self, con, args):
        self.con, self.args = con, args
        self.cost = make_coster()
        self.n = {'requests': 0, 'tools': 0, 'prompts': 0, 'events': 0, 'files': 0}
        self.touched = set()  # sessions with new prompts: their frustration scores are worked out again

    # ---- transcripts -------------------------------------------------------
    def transcript(self, path, profile, agent_id, start):
        con = self.con
        sess_upd = {}
        with open(path, 'rb') as fh:
            fh.seek(start)
            data = fh.read()
        end = data.rfind(b'\n') + 1
        lines = data[:end].split(b'\n')
        for raw in lines:
            if not raw:
                continue
            try:
                d = json.loads(raw)
            except Exception:
                continue
            t = d.get('type')
            sid = d.get('sessionId')
            ts = d.get('timestamp')
            if t == 'assistant':
                self.assistant(d, profile, agent_id)
            elif t == 'user':
                self.user(d, profile, agent_id)
            elif t == 'attachment':
                a = d.get('attachment') or {}
                day, _ = local(ts) if ts else (None, None)
                con.execute('INSERT OR IGNORE INTO attachments VALUES (?,?,?,?,?,?,?,?)',
                            (d.get('uuid'), profile, sid, agent_id, ts, day, a.get('type'), size_of(a)))
            elif t == 'system':
                day, _ = local(ts) if ts else (None, None)
                st = d.get('subtype')
                keep = {k: v for k, v in d.items() if k not in ('parentUuid', 'uuid', 'cwd', 'sessionId', 'session_id', 'userType', 'entrypoint', 'version', 'gitBranch', 'type', 'isSidechain', 'timestamp')}
                con.execute('INSERT OR IGNORE INTO system_events VALUES (?,?,?,?,?,?,?,?,?,?)',
                            (d.get('uuid'), profile, sid, agent_id, ts, day, st, d.get('durationMs'), d.get('messageCount'),
                             json.dumps(scrub(keep), ensure_ascii=False)[:4000]))
            elif t == 'ai-title' and sid:
                sess_upd.setdefault(sid, {})['title'] = d.get('aiTitle')
            elif t == 'cost-state' and sid:
                sess_upd.setdefault(sid, {}).update(cc=d)
            if sid and ts and t in ('assistant', 'user') and not agent_id:
                s = sess_upd.setdefault(sid, {})
                s['first'] = min(s.get('first', ts), ts)
                s['last'] = max(s.get('last', ts), ts)
                for k, dk in (('cwd', 'cwd'), ('branch', 'gitBranch'), ('version', 'version'), ('entrypoint', 'entrypoint')):
                    if d.get(dk):
                        s[k] = d[dk]
        for sid, s in sess_upd.items():
            con.execute('INSERT OR IGNORE INTO sessions (session_id, profile) VALUES (?,?)', (sid, profile))
            if 'first' in s:
                con.execute('''UPDATE sessions SET first_ts = MIN(COALESCE(first_ts, ?), ?), last_ts = MAX(COALESCE(last_ts, ?), ?),
                               cwd = COALESCE(?, cwd), project = COALESCE(?, project), git_branch = COALESCE(?, git_branch),
                               version = COALESCE(?, version), entrypoint = COALESCE(?, entrypoint) WHERE session_id = ?''',
                            (s['first'], s['first'], s['last'], s['last'], s.get('cwd'), project_of(s.get('cwd')),
                             s.get('branch'), s.get('version'), s.get('entrypoint'), sid))
            if s.get('title'):
                con.execute('UPDATE sessions SET title = ? WHERE session_id = ?', (s['title'], sid))
            if s.get('cc'):
                c = s['cc']
                con.execute('''UPDATE sessions SET cc_cost_usd=?, cc_api_ms=?, cc_tool_ms=?, cc_duration_ms=?, lines_added=?, lines_removed=?
                               WHERE session_id=?''', (c.get('totalCostUSD'), c.get('totalAPIDuration'), c.get('totalToolDuration'),
                                                       c.get('totalDuration'), c.get('totalLinesAdded'), c.get('totalLinesRemoved'), sid))
        return end, len(lines)

    def assistant(self, d, profile, agent_id):
        m = d.get('message') or {}
        mid = m.get('id')
        model = m.get('model')
        if not mid or model == '<synthetic>':
            return
        u = m.get('usage') or {}
        cc = u.get('cache_creation') or {}
        st = u.get('server_tool_use') or {}
        ts = d.get('timestamp')
        day, hour = local(ts) if ts else (None, None)
        inp, out = u.get('input_tokens') or 0, u.get('output_tokens') or 0
        cr, cw = u.get('cache_read_input_tokens') or 0, u.get('cache_creation_input_tokens') or 0
        cw5, cw1 = cc.get('ephemeral_5m_input_tokens') or 0, cc.get('ephemeral_1h_input_tokens') or 0
        speed = u.get('speed') or 'standard'
        blocks = m.get('content') or []
        text_chars = sum(len(b.get('text') or '') for b in blocks if isinstance(b, dict) and b.get('type') == 'text')
        thinking_blocks = sum(1 for b in blocks if isinstance(b, dict) and b.get('type') in ('thinking', 'redacted_thinking'))
        tool_blocks = sum(1 for b in blocks if isinstance(b, dict) and b.get('type') == 'tool_use')
        cwd = d.get('cwd')
        aid = agent_id or d.get('agentId')
        self.con.execute('''INSERT INTO requests VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
          ON CONFLICT(msg_id) DO UPDATE SET
            input = MAX(input, excluded.input), output = MAX(output, excluded.output),
            cache_read = MAX(cache_read, excluded.cache_read), cache_write = MAX(cache_write, excluded.cache_write),
            cw_5m = MAX(cw_5m, excluded.cw_5m), cw_1h = MAX(cw_1h, excluded.cw_1h), thinking = MAX(thinking, excluded.thinking),
            stop_reason = COALESCE(excluded.stop_reason, stop_reason),
            text_chars = text_chars + excluded.text_chars, thinking_blocks = thinking_blocks + excluded.thinking_blocks,
            tool_blocks = tool_blocks + excluded.tool_blocks,
            cost_usd = MAX(COALESCE(cost_usd, 0), COALESCE(excluded.cost_usd, 0))
          WHERE excluded.session_id = requests.session_id''',
            (mid, d.get('requestId'), profile, d.get('sessionId'), aid, 1 if d.get('isSidechain') else 0,
             ts, day, hour, cwd, project_of(cwd), d.get('gitBranch'), d.get('version'), d.get('entrypoint'),
             model, d.get('effort'), m.get('stop_reason'), u.get('service_tier'), speed, u.get('inference_geo'),
             inp, out, cr, cw, cw5, cw1, (u.get('output_tokens_details') or {}).get('thinking_tokens') or 0,
             st.get('web_search_requests') or 0, st.get('web_fetch_requests') or 0, len(u.get('iterations') or []) or 1,
             text_chars, thinking_blocks, tool_blocks, self.cost(model, speed, inp, out, cr, cw5, cw1, cw)))
        self.n['requests'] += 1
        for b in blocks:
            if isinstance(b, dict) and b.get('type') in ('tool_use', 'server_tool_use', 'mcp_tool_use'):
                name = b.get('name') or '?'
                f = {k: redact(v) for k, v in tool_facets(name, b.get('input')).items()}
                lines_out, wrote = quality.written(name, b.get('input'))
                repl = quality.replaced(name, b.get('input'))
                self.con.execute('''INSERT INTO tool_uses (id, msg_id, profile, session_id, agent_id, ts, day, project, tool, input_chars,
                    file, ext, cmd, pattern, subagent, skill, mcp_server, detail, verify, lines_out, wrote, replaced) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
                    ON CONFLICT(id) DO UPDATE SET msg_id=excluded.msg_id, tool=excluded.tool, input_chars=excluded.input_chars,
                    file=excluded.file, ext=excluded.ext, cmd=excluded.cmd, pattern=excluded.pattern, subagent=excluded.subagent,
                    skill=excluded.skill, mcp_server=excluded.mcp_server, detail=excluded.detail, ts=excluded.ts, day=excluded.day,
                    verify=excluded.verify, lines_out=excluded.lines_out, wrote=excluded.wrote, replaced=excluded.replaced''',
                    (b.get('id'), mid, profile, d.get('sessionId'), aid, ts, day, project_of(cwd), name, size_of(b.get('input')),
                     f['file'], f['ext'], f['cmd'], f['pattern'], f['subagent'], f['skill'], f['mcp_server'], f['detail'],
                     f['verify'], lines_out, wrote, repl))
                self.n['tools'] += 1

    def user(self, d, profile, agent_id):
        m = d.get('message') or {}
        c = m.get('content')
        ts = d.get('timestamp')
        day, _ = local(ts) if ts else (None, None)
        aid = agent_id or d.get('agentId')
        if isinstance(c, list):
            texts = []
            for b in c:
                if not isinstance(b, dict):
                    continue
                if b.get('type') == 'tool_result':
                    chars, imgs = result_size(b.get('content'))
                    self.con.execute('''INSERT INTO tool_uses (id, profile, session_id, agent_id, result_chars, result_images, is_error, result_ts, flag)
                        VALUES (?,?,?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET result_chars=excluded.result_chars,
                        result_images=excluded.result_images, is_error=excluded.is_error, result_ts=excluded.result_ts, flag=excluded.flag''',
                        (b.get('tool_use_id'), profile, d.get('sessionId'), aid, chars, imgs, 1 if b.get('is_error') else 0, ts,
                         quality.result_flag(result_text(b.get('content')))))
                elif b.get('type') == 'text':
                    texts.append(b.get('text') or '')
            text = '\n'.join(texts)
        elif isinstance(c, str):
            text = c
        else:
            return
        if not text or not d.get('uuid'):
            return
        kind = prompt_kind(text, d.get('isMeta'), bool(aid) and d.get('parentUuid') is None)
        self.touched.add(d.get('sessionId'))
        self.con.execute('INSERT OR IGNORE INTO prompts VALUES (?,?,?,?,?,?,?,?,?,?)',
                         (d['uuid'], profile, d.get('sessionId'), aid, ts, day, project_of(d.get('cwd')), kind, len(text),
                          redact(text if kind in ('prompt', 'command', 'agent_prompt') else text[:500])))
        self.n['prompts'] += 1

    def agent_meta(self, path, profile):
        aid = os.path.basename(path)[len('agent-'):-len('.meta.json')]
        sid = os.path.basename(os.path.dirname(os.path.dirname(path)))
        try:
            with open(path) as f:
                m = json.load(f)
        except Exception:
            return
        self.con.execute('INSERT OR REPLACE INTO agents VALUES (?,?,?,?,?,?,?,?,?)',
                         (aid, profile, sid, m.get('agentType'), m.get('description'), m.get('toolUseId'),
                          m.get('parentAgentId'), m.get('spawnDepth'), m.get('requestShape')))

    # ---- mod events --------------------------------------------------------
    def events(self, path, start):
        n = 0
        with open(path, 'rb') as fh:
            fh.seek(start)
            data = fh.read()
        end = data.rfind(b'\n') + 1
        for i, raw in enumerate(data[:end].split(b'\n')):
            if not raw:
                continue
            try:
                d = json.loads(raw)
            except Exception:
                continue
            ts = d.pop('ts', None)
            day = datetime.fromtimestamp(ts / 1000).strftime('%Y-%m-%d') if isinstance(ts, (int, float)) else None
            ev, sid, prof = d.pop('ev', None), d.pop('sid', None), d.pop('profile', None)
            self.con.execute('INSERT OR IGNORE INTO events VALUES (?,?,?,?,?,?,?,?)',
                             (path, start + i, ts, day, ev, sid, prof, json.dumps(scrub(d), ensure_ascii=False)))
            if ev == 'session_start' and sid:
                self.con.execute('INSERT OR IGNORE INTO sessions (session_id, profile) VALUES (?,?)', (sid, prof))
            n += 1
        self.n['events'] += n
        return end, n

    def backfill_quality(self, budget_s=None):
        """Once, after an upgrade to schema 2: read the transcripts again for the columns that version added
        (checks, failure marks, written lines). Resumes where it stopped when the time budget runs out."""
        con = self.con
        if not con.execute("SELECT 1 FROM meta WHERE k = 'backfill_quality'").fetchone():
            return
        con.execute('CREATE TABLE IF NOT EXISTS quality_backfill (path TEXT PRIMARY KEY)')
        t0 = time.time()
        todo = [r[0] for r in con.execute("SELECT path FROM files WHERE kind = 'transcript' AND path NOT IN (SELECT path FROM quality_backfill)")]
        log(self.args, f'quality backfill: {len(todo)} transcripts to read again')
        for i, path in enumerate(todo):
            if budget_s and time.time() - t0 > budget_s:
                con.commit()
                log(self.args, f'quality backfill: paused after {i} files, the next import goes on')
                return
            try:
                with open(path, 'rb') as fh:
                    for raw in fh:
                        if b'"tool_use"' not in raw and b'"tool_result"' not in raw:
                            continue
                        try:
                            d = json.loads(raw)
                        except Exception:
                            continue
                        c = (d.get('message') or {}).get('content')
                        for b in c if isinstance(c, list) else []:
                            if not isinstance(b, dict):
                                continue
                            if b.get('type') == 'tool_use':
                                lines_out, wrote = quality.written(b.get('name'), b.get('input'))
                                verify = tool_facets(b.get('name') or '', b.get('input'))['verify']
                                if verify or wrote is not None:
                                    con.execute('UPDATE tool_uses SET verify = ?, lines_out = ?, wrote = ?, replaced = ? WHERE id = ?',
                                                (verify, lines_out, wrote, quality.replaced(b.get('name'), b.get('input')), b.get('id')))
                            elif b.get('type') == 'tool_result':
                                flag = quality.result_flag(result_text(b.get('content')))
                                if flag:
                                    con.execute('UPDATE tool_uses SET flag = ? WHERE id = ?', (flag, b.get('tool_use_id')))
            except OSError:
                pass
            con.execute('INSERT OR IGNORE INTO quality_backfill VALUES (?)', (path,))
            if i % 200 == 199:
                con.commit()
        con.execute('DROP TABLE quality_backfill')
        con.execute("DELETE FROM meta WHERE k = 'backfill_quality'")
        con.commit()
        log(self.args, f'quality backfill: done in {time.time() - t0:.0f}s')

    # ---- driver ------------------------------------------------------------
    def sources(self):
        cfg = {}
        try:
            with open(os.path.join(DATA, 'config.json')) as f:
                cfg = json.load(f)
        except Exception:
            pass
        for root in profile_dirs(cfg):
            profile = os.path.basename(root.rstrip('/')).lstrip('.')
            proj = os.path.join(root, 'projects')
            for dirpath, dirs, files in os.walk(proj):
                in_sub = os.path.basename(dirpath) == 'subagents'
                for fn in files:
                    p = os.path.join(dirpath, fn)
                    if fn.endswith('.meta.json') and in_sub:
                        yield 'agent_meta', profile, p, None
                    elif fn.endswith('.jsonl'):
                        aid = fn[len('agent-'):-len('.jsonl')] if in_sub and fn.startswith('agent-') else None
                        yield 'transcript', profile, p, aid
        for p in glob.glob(os.path.join(DATA, 'events', '*', '*', '*.jsonl')):
            yield 'events', p.split(os.sep)[-3], p, None

    def gateway(self):
        """What the gateway billed: <data>/gateway/key-<fingerprint>.json, written by the mod from LiteLLM
        /user/daily/activity, one file per key with every profile that used it. The table is rebuilt from the files.
        A key's spend is filed under one profile, the one of its profiles with the most requests lately, so a key two
        profiles share is counted once; the list price it is compared with covers all of its profiles.
        Older per-profile files (<profile>.json, no key) count only for a host no key file covers, newest first."""
        if len(self.con.execute('PRAGMA table_info(gateway_spend)').fetchall()) != 9:
            # an earlier shape of the table: it is rebuilt from the files anyway
            self.con.execute('DROP TABLE gateway_spend')
            self.con.executescript(DDL)
        files = []
        for path in glob.glob(os.path.join(DATA, 'gateway', '*.json')):
            try:
                with open(path) as f:
                    g = json.load(f)
            except (OSError, ValueError) as ex:
                log(self.args, f'skip {path}: {ex}')
                continue
            if not g.get('key'):
                g['profiles'] = [g.get('profile') or os.path.basename(path)[:-5]]
            files.append(g)
        keyed_hosts = {g.get('host') for g in files if g.get('key')}
        merged = {}
        for g in sorted(files, key=lambda g: g.get('syncedAt') or ''):
            if g.get('key'):
                merged[g['key']] = g
            elif g.get('host') not in keyed_hosts:
                # the same key synced from several profiles before files were per key: the newest copy wins
                k = 'host:' + str(g.get('host'))
                g['profiles'] = sorted(set(g['profiles']) | set(merged.get(k, {}).get('profiles', [])))
                merged[k] = g
        busy = dict(self.con.execute("SELECT profile, COUNT(*) FROM requests WHERE day >= date('now', '-90 days') GROUP BY profile"))
        self.con.execute('DELETE FROM gateway_spend')
        self.con.execute('DELETE FROM gateway_sync')
        for k, g in merged.items():
            profs = sorted(set(g.get('profiles') or []))
            if not profs:
                continue
            prof = max(profs, key=lambda p: (busy.get(p, 0), -profs.index(p)))
            rows = []
            for day, d in (g.get('days') or {}).items():
                models = d.get('models') or {}
                rest = float(d.get('spend') or 0) - sum(float(v.get('spend') or 0) for v in models.values())
                rows += [(prof, day, m, float(v.get('spend') or 0), v.get('requests'), v.get('input'), v.get('output'),
                          v.get('cacheRead'), v.get('cacheWrite')) for m, v in models.items()]
                if abs(rest) > 0.005:
                    rows.append((prof, day, '(other)', rest, None, None, None, None, None))
            # two keys filed under one profile add up
            self.con.executemany('''INSERT INTO gateway_spend VALUES (?,?,?,?,?,?,?,?,?)
                ON CONFLICT DO UPDATE SET spend_usd = spend_usd + excluded.spend_usd''', rows)
            self.con.execute('INSERT OR REPLACE INTO gateway_sync VALUES (?,?,?,?,?,?,?,?)',
                             (k, prof, json.dumps(profs), g.get('host'), g.get('syncedAt'), g.get('checkedAt') or g.get('syncedAt'),
                              g.get('error'), max(g.get('days') or {'': 0})))

    def run(self, full=False, progress=None):
        con = self.con
        if full:
            for t in ('files', 'requests', 'tool_uses', 'prompts', 'attachments', 'system_events', 'sessions', 'agents', 'events', 'mood'):
                con.execute(f'DELETE FROM {t}')
            con.execute("DELETE FROM meta WHERE k = 'backfill_quality'")
        known = {r[0]: r[1:] for r in con.execute('SELECT path, size, mtime, offset FROM files')}
        todo = []
        for kind, profile, path, aid in self.sources():
            try:
                st = os.stat(path)
            except OSError:
                continue
            k = known.get(path)
            if k and k[0] == st.st_size and abs(k[1] - st.st_mtime) < 1e-6:
                continue
            start = k[2] if k and st.st_size >= k[0] else 0
            todo.append((kind, profile, path, aid, st, start))
        # main transcripts before subagents so sessions are attributed to the top-level file
        todo.sort(key=lambda x: (x[0] != 'transcript', x[3] is not None, x[2]))
        t0, last_commit = time.time(), time.time()
        # A long ingest (the first one backfills every transcript on disk) reports how far it got.
        backfill = sum(1 for x in todo if x[5] == 0) > 50
        # Stages in the order todo runs them, for the progress bar: sessions, subagents, mod events.
        stage_total, stage_start = {}, {}
        for j, x in enumerate(todo):
            st_ = stage_of(x[0], x[3])
            stage_start.setdefault(st_, j)
            stage_total[st_] = stage_total.get(st_, 0) + 1
        state = {'running': True, 'backfill': backfill, 'total': len(todo), 'done': 0, 'requests': 0, 'startedAt': int(t0),
                 'stages': [k for k in ('sessions', 'subagents', 'mod events') if k in stage_total]}
        if backfill:
            write_progress(state, progress)
        for i, (kind, profile, path, aid, st, start) in enumerate(todo):
            try:
                if kind == 'agent_meta':
                    self.agent_meta(path, profile)
                    end, n = st.st_size, 1
                elif kind == 'events':
                    rel, n = self.events(path, start)
                    end = start + rel
                else:
                    rel, n = self.transcript(path, profile, aid, start)
                    end = start + rel
            except Exception as ex:  # one bad file must not stop the rest
                log(self.args, f'skip {path}: {ex}')
                continue
            con.execute('INSERT OR REPLACE INTO files VALUES (?,?,?,?,?,?,?,?)',
                        (path, kind, profile, st.st_size, st.st_mtime, end, n, datetime.now().isoformat(timespec='seconds')))
            self.n['files'] += 1
            if time.time() - last_commit > 5:
                con.commit()
                last_commit = time.time()
                log(self.args, f'  {i + 1}/{len(todo)} files, {self.n["requests"]} request rows, {time.time() - t0:.0f}s')
                if backfill:
                    write_progress({**state, 'done': i + 1, 'requests': self.n['requests'], 'stage': stage_of(kind, aid),
                                    'profile': profile, 'stageDone': i + 1 - stage_start[stage_of(kind, aid)],
                                    'stageTotal': stage_total[stage_of(kind, aid)]}, progress)
        self.gateway()
        con.commit()
        self.backfill_quality(budget_s=240 if getattr(self.args, 'quiet', False) else None)
        try:
            n = frustration.refresh(con, [s for s in self.touched if s])
            if n:
                log(self.args, f'frustration: scored the prompts of {n} sessions')
        except Exception as ex:  # a scoring bug must not fail the import
            log(self.args, f'frustration: {ex}')
        if git_outcomes_on():
            try:
                quality.refresh_git(con, budget_s=15)
            except Exception as ex:  # git trouble must not fail the import
                log(self.args, f'git outcomes: {ex}')
        if backfill:
            write_progress({**state, 'running': False, 'done': len(todo), 'requests': self.n['requests'], 'finishedAt': int(time.time())}, progress)
        log(self.args, f'ingested {self.n["files"]} files: {self.n["requests"]} request rows, {self.n["tools"]} tool calls, '
                       f'{self.n["prompts"]} prompts, {self.n["events"]} mod events in {time.time() - t0:.1f}s')


def git_outcomes_on():
    return paths.config().get('gitOutcomes', True) is not False


def stage_of(kind, aid):
    return 'mod events' if kind == 'events' else 'subagents' if kind == 'agent_meta' or aid is not None else 'sessions'


def profile_dirs(cfg=None):
    """Claude config dirs to read transcripts from: `profileDirs` from config when set, else every ~/.claude*
    dir with a projects/ folder plus each dir a session with the mod ran from (<data>/profiles/*.json)."""
    cfg = paths.config() if cfg is None else cfg
    if cfg.get('profileDirs'):
        return [os.path.expanduser(p) for p in cfg['profileDirs']]
    dirs = set(p for p in glob.glob(os.path.join(HOME, '.claude*')) if os.path.isdir(os.path.join(p, 'projects')))
    for f in glob.glob(os.path.join(DATA, 'profiles', '*.json')):
        try:
            d = json.load(open(f)).get('configDir')
        except (OSError, ValueError):
            continue
        if d and os.path.isdir(os.path.join(d, 'projects')):
            dirs.add(d)
    seen, out = set(), []
    for d in sorted(dirs):
        r = os.path.realpath(d)
        if r not in seen:
            seen.add(r)
            out.append(d)
    return out


def write_progress(state, progress=None):
    try:
        with open(os.path.join(DATA, 'ingest-progress.json.tmp'), 'w') as f:
            json.dump(state, f)
        os.replace(os.path.join(DATA, 'ingest-progress.json.tmp'), os.path.join(DATA, 'ingest-progress.json'))
    except OSError:
        pass
    if progress:
        progress(state)


def cmd_ingest(args):
    os.makedirs(DATA, exist_ok=True)
    lock = open(os.path.join(DATA, 'ingest.lock'), 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | (fcntl.LOCK_NB if args.quiet else 0))
    except BlockingIOError:
        return 0  # another ingest is running; this one's data will be picked up by it or the next
    con = connect()
    Ingest(con, args).run(full=getattr(args, 'full', False), progress=getattr(args, 'progress', None))
    con.close()
    return 0


def cmd_reprice(args):
    con = connect()
    cost = make_coster()
    rows = con.execute('SELECT msg_id, model, speed, input, output, cache_read, cw_5m, cw_1h, cache_write FROM requests').fetchall()
    con.executemany('UPDATE requests SET cost_usd = ? WHERE msg_id = ?',
                    [(cost(m, sp, i, o, cr, c5, c1, cw), mid) for mid, m, sp, i, o, cr, c5, c1, cw in rows])
    con.commit()
    missing = con.execute("SELECT model, COUNT(*) FROM requests WHERE cost_usd IS NULL GROUP BY model").fetchall()
    print(f'repriced {len(rows)} requests' + (f'; no price for: {missing}' if missing else ''))
    return 0


# ---- reporting -------------------------------------------------------------
def fmt(v):
    if v is None:
        return '-'
    if isinstance(v, float):
        if abs(v) >= 100:
            return f'{v:,.0f}'
        return f'{v:,.2f}'
    if isinstance(v, int):
        a = abs(v)
        if a >= 1e9:
            return f'{v / 1e9:.2f}B'
        if a >= 1e6:
            return f'{v / 1e6:.1f}M'
        if a >= 1e4:
            return f'{v / 1e3:.0f}k'
        return f'{v:,}'
    s = str(v)
    return s if len(s) <= 60 else s[:57] + '...'


def table(con, title, sql, params=(), out=None):
    cur = con.execute(sql, params)
    cols = [c[0] for c in cur.description]
    rows = [[fmt(v) for v in r] for r in cur.fetchall()]
    w = [max([len(c)] + [len(r[i]) for r in rows]) for i, c in enumerate(cols)]
    lines = [f'\n## {title}', '  '.join(c.ljust(w[i]) if i == 0 else c.rjust(w[i]) for i, c in enumerate(cols))]
    lines.append('  '.join('-' * x for x in w))
    for r in rows:
        lines.append('  '.join(v.ljust(w[i]) if i == 0 else v.rjust(w[i]) for i, v in enumerate(r)))
    if not rows:
        lines.append('(no data)')
    print('\n'.join(lines), file=out or sys.stdout)


TOK = '''SUM(input) "in", SUM(output) "out", SUM(cache_read) "cache rd", SUM(cache_write) "cache wr",
  ROUND(100.0 * SUM(cache_read) / NULLIF(SUM(input + cache_read + cache_write), 0), 1) "hit %",
  ROUND(SUM(cost_usd), 2) "est $"'''


def cmd_report(args):
    if args.ingest:
        a = argparse.Namespace(quiet=True, full=False)
        cmd_ingest(a)
    con = connect()
    since = (datetime.now() - timedelta(days=args.days - 1)).strftime('%Y-%m-%d') if args.days else '0000'
    w, p = ['day >= ?'], [since]
    if args.profile:
        profs = [x if x.startswith('claude') else f'claude-{x}' for x in args.profile.split(',')]
        w.append(f'profile IN ({",".join("?" * len(profs))})')
        p += profs
    if args.project:
        w.append('project LIKE ?')
        p.append(f'%{args.project}%')
    W = ' AND '.join(w)
    L = args.limit
    what = args.what
    span = f'last {args.days} days' if args.days else 'all time'
    scope = f"{span}{', profile ' + args.profile if args.profile else ''}{', project ~' + args.project if args.project else ''}"
    print(f'# Claude Code usage: {scope}  (costs are list-price estimates from {PRICING})')

    def want(*names):
        return what in names or what == 'all'

    if want('overview', 'profiles'):
        table(con, 'By profile', f'''SELECT profile, COUNT(DISTINCT session_id) sessions, COUNT(*) requests, {TOK}
            FROM requests WHERE {W} GROUP BY profile UNION ALL
            SELECT 'TOTAL', COUNT(DISTINCT session_id), COUNT(*), {TOK} FROM requests WHERE {W}''', p + p)
    if want('overview', 'daily'):
        table(con, 'By day', f'''SELECT day, COUNT(DISTINCT session_id) sessions, COUNT(*) requests, {TOK},
            GROUP_CONCAT(DISTINCT profile) profiles FROM requests WHERE {W} GROUP BY day ORDER BY day DESC LIMIT ?''', p + [L if what != 'overview' else 14])
    if want('gateway') or (what == 'overview' and con.execute('SELECT 1 FROM gateway_spend LIMIT 1').fetchone()):
        gw, gp = ['day >= ?'], [since]
        if args.profile:
            gw.append(f'profile IN ({",".join("?" * len(profs))})')
            gp += profs
        G = ' AND '.join(gw)
        table(con, 'Gateway billed (LiteLLM) vs list-price estimate, by day', f'''SELECT g.day, g.profile, ROUND(g.billed, 2) billed_usd,
            ROUND(r.list, 2) list_usd, ROUND(g.billed / NULLIF(r.list, 0), 2) ratio FROM
            (SELECT day, profile, SUM(spend_usd) billed FROM gateway_spend WHERE {G} GROUP BY day, profile) g
            LEFT JOIN (SELECT r.day, s.profile, SUM(r.cost_usd) list FROM requests r
                JOIN gateway_sync s ON r.profile IN (SELECT value FROM json_each(s.profiles)) GROUP BY r.day, s.profile) r USING (day, profile)
            ORDER BY g.day DESC LIMIT ?''', gp + [L if what != 'overview' else 14])
        table(con, 'Gateway billed by model', f'''SELECT model, ROUND(SUM(spend_usd), 2) billed_usd, SUM(requests) requests,
            SUM(input) input, SUM(output) output, SUM(cache_read) cache_read, SUM(cache_write) cache_write, COUNT(DISTINCT day) days
            FROM gateway_spend WHERE {G} GROUP BY model ORDER BY SUM(spend_usd) DESC''', gp)
    if want('overview', 'models'):
        table(con, 'By model', f'''SELECT model, speed, COUNT(*) requests, {TOK}, SUM(thinking) thinking
            FROM requests WHERE {W} GROUP BY model, speed ORDER BY SUM(cost_usd) DESC''', p)
    if want('overview', 'agents'):
        table(con, 'Main loop vs subagents (by agent type)', f'''SELECT agent_type, COUNT(DISTINCT COALESCE(agent_id, session_id)) agents,
            COUNT(*) requests, {TOK} FROM v_requests WHERE {W} GROUP BY agent_type ORDER BY SUM(cost_usd) DESC LIMIT ?''', p + [L])
    if want('overview', 'projects'):
        table(con, 'By project', f'''SELECT project, COUNT(DISTINCT session_id) sessions, COUNT(*) requests, {TOK}
            FROM requests WHERE {W} GROUP BY project ORDER BY SUM(cost_usd) DESC LIMIT ?''', p + [L])
    if want('overview', 'tools'):
        table(con, 'Tools: what they put into the context (result chars ~ 4 per token)', f'''SELECT tool, COUNT(*) calls,
            SUM(input_chars) "in chars", SUM(result_chars) "result chars", ROUND(AVG(result_chars)) "avg result",
            MAX(result_chars) "max result", SUM(result_images) images, SUM(is_error) errors,
            ROUND(100.0 * SUM(result_chars) / NULLIF((SELECT SUM(result_chars) FROM tool_uses WHERE {W}), 0), 1) "% results"
            FROM tool_uses WHERE {W} AND tool IS NOT NULL GROUP BY tool ORDER BY SUM(result_chars) DESC LIMIT ?''', p + p + [L])
    if want('bash'):
        table(con, 'Bash by command', f'''SELECT cmd, COUNT(*) calls, SUM(result_chars) "result chars", ROUND(AVG(result_chars)) "avg",
            MAX(result_chars) "max", SUM(is_error) errors FROM tool_uses WHERE {W} AND tool = 'Bash'
            GROUP BY cmd ORDER BY SUM(result_chars) DESC LIMIT ?''', p + [L])
    if want('files'):
        table(con, 'Files read/edited most (by chars returned)', f'''SELECT file, SUM(tool = 'Read') reads, SUM(tool = 'Edit') edits,
            SUM(tool = 'Write') writes, SUM(CASE WHEN tool = 'Read' THEN result_chars END) "read chars",
            SUM(CASE WHEN tool = 'Write' THEN input_chars END) "write chars"
            FROM tool_uses WHERE {W} AND file IS NOT NULL GROUP BY file ORDER BY SUM(result_chars) + SUM(input_chars) DESC LIMIT ?''', p + [L])
        table(con, 'Re-reads: the same file read again in one session', f'''SELECT file, session_id, COUNT(*) reads, SUM(result_chars) chars
            FROM tool_uses WHERE {W} AND tool = 'Read' GROUP BY session_id, file HAVING COUNT(*) > 2 ORDER BY SUM(result_chars) DESC LIMIT ?''', p + [L])
    if want('sessions'):
        table(con, 'Most expensive sessions', f'''SELECT r.session_id, r.profile, MIN(r.day) day, s.title, COUNT(*) requests,
            MAX(r.input + r.cache_read + r.cache_write) "peak ctx", ROUND(SUM(r.cost_usd), 2) "est $", ROUND(s.cc_cost_usd, 2) "cc $"
            FROM requests r LEFT JOIN sessions s USING (session_id) WHERE {" AND ".join("r." + x for x in w)}
            GROUP BY r.session_id ORDER BY SUM(r.cost_usd) DESC LIMIT ?''', p + [L])
    if want('overview', 'cache'):
        table(con, 'Context size per request (main loop)', f'''SELECT CASE
              WHEN input + cache_read + cache_write < 50000 THEN 'a <50k' WHEN input + cache_read + cache_write < 100000 THEN 'b 50-100k'
              WHEN input + cache_read + cache_write < 200000 THEN 'c 100-200k' WHEN input + cache_read + cache_write < 400000 THEN 'd 200-400k'
              ELSE 'e 400k+' END bucket, COUNT(*) requests, {TOK}
            FROM requests WHERE {W} AND agent_id IS NULL GROUP BY bucket ORDER BY bucket''', p)
        cost = make_coster()
        split = {'input': 0.0, 'output': 0.0, 'cache read': 0.0, 'cache write': 0.0}
        for m, sp, i, o, cr, c5, c1, cw in con.execute(f'''SELECT model, speed, SUM(input), SUM(output), SUM(cache_read), SUM(cw_5m),
                SUM(cw_1h), SUM(cache_write) FROM requests WHERE {W} GROUP BY model, speed''', p):
            split['input'] += cost(m, sp, i, 0, 0, 0, 0, 0) or 0
            split['output'] += cost(m, sp, 0, o, 0, 0, 0, 0) or 0
            split['cache read'] += cost(m, sp, 0, 0, cr, 0, 0, 0) or 0
            split['cache write'] += cost(m, sp, 0, 0, 0, c5, c1, cw) or 0
        total = sum(split.values()) or 1
        print('\n## Spend by token kind\n' + '\n'.join(f'{k:12} ${v:>10,.2f}  {100 * v / total:5.1f}%' for k, v in split.items()))
    if want('context'):
        table(con, 'Injected context (attachments) by type', f'''SELECT type, COUNT(*) n, SUM(chars) chars, ROUND(AVG(chars)) avg
            FROM attachments WHERE {W.replace("project LIKE ?", "1")} GROUP BY type ORDER BY SUM(chars) DESC LIMIT ?''', p + [L])
        table(con, 'Latest /context breakdown per profile (from the mod)', f'''SELECT profile, category, MAX(tokens) tokens, deferred
            FROM v_context WHERE ts = (SELECT MAX(ts) FROM events e WHERE e.ev = 'context' AND e.profile = v_context.profile)
            GROUP BY profile, category ORDER BY profile, tokens DESC''')
        table(con, 'Tool definitions (chars, from the mod)', '''SELECT tool, MAX(chars) chars, deferred FROM v_tool_schemas
            GROUP BY tool, deferred ORDER BY chars DESC LIMIT ?''', [L])
        table(con, 'Compactions', f'''SELECT day, subtype, COUNT(*) n FROM system_events WHERE {W.replace("project LIKE ?", "1")}
            AND subtype IN ('compact_boundary', 'api_error') GROUP BY day, subtype ORDER BY day DESC LIMIT ?''', p + [L])
    if want('quality'):
        import advisor
        profs = [x if x.startswith('claude') else f'claude-{x}' for x in args.profile.split(',')] if args.profile else None
        rows = advisor.sessions(con, since, profiles=profs)
        if args.project:
            rows = [r for r in rows if args.project in (r['project'] or '')]
        tot = lambda k: sum(r[k] for r in rows)
        print(f"\n## Output quality ({len(rows)} sessions; git outcomes for {sum(1 for r in rows if r['files_edited'])} of them)")
        for key in ('correction_rate', 'interrupt_rate', 'rejection_rate', 'edit_churn', 'verify_pass', 'verify_coverage',
                    'edit_survival', 'files_shipped', 'idle_recache'):
            m = advisor.M[key]
            print(f'{m[1]:<40} {advisor.fmt_value(key, advisor.value(rows, key)):>10}   ({tot(m[3]):,.0f} / {tot(m[4]):,.0f})')
        pend = con.execute("SELECT COUNT(*) FROM git_outcomes WHERE state = 'pending'").fetchone()[0]
        print(f'git outcomes waiting for a commit: {pend} sessions' + ('' if git_outcomes_on() else '  (off: gitOutcomes is false in config.json)'))
        fv = lambda rs, k: (lambda v: fmt(round(v, 3 if k == 'cost_per_prompt' else 1)) if v is not None else '-')(advisor.value(rs, k))
        for title, by in (('By model (main loop)', lambda r: r['model']), ('By model and effort', lambda r: f"{r['model']} / {r['effort'] or '-'}"),
                          ('By project', lambda r: r['project'])):
            head, body = quality.compare_table(rows, by, fv, top=L)
            print(f'\n## Cost vs quality: {title.lower()}\n' + ' | '.join(head))
            for row in body:
                print(' | '.join(str(x) for x in row))
    if want('frustration'):
        M = '''COUNT(*) prompts, ROUND(AVG(score), 1) avg_score, SUM(score >= 50) frustrated, SUM(score >= 75) rage,
            ROUND(100.0 * SUM(score >= 50) / COUNT(*), 1) frustrated_pct, MAX(score) peak'''
        print('\n## Frustration (0 calm .. 100 rage per prompt; frustrated 50+, rage 75+; rules in bin/frustration.py)')
        table(con, 'Overall', f'SELECT {M} FROM mood WHERE {W}', p)
        table(con, 'By week', f"SELECT date(day, 'weekday 0', '-6 days') week, {M} FROM mood WHERE {W} GROUP BY 1 ORDER BY 1 DESC LIMIT ?", p + [L])
        table(con, 'By day', f'SELECT day, {M} FROM mood WHERE {W} GROUP BY day ORDER BY day DESC LIMIT ?', p + [L])
        table(con, 'Signals', f'''SELECT s.value signal, COUNT(*) prompts, ROUND(AVG(score), 1) avg_score FROM mood, json_each(mood.signals) s
            WHERE {W} GROUP BY 1 ORDER BY prompts DESC''', p)
        table(con, 'By model and effort (the turn before the prompt)', f'''SELECT COALESCE(model, '?') model, COALESCE(effort, '-') effort, {M}
            FROM mood WHERE {W} GROUP BY 1, 2 HAVING prompts >= 5 ORDER BY avg_score DESC''', p)
        table(con, 'By project', f'SELECT project, {M} FROM mood WHERE {W} GROUP BY project HAVING prompts >= 5 ORDER BY avg_score DESC LIMIT ?', p + [L])
        table(con, 'Most heated prompts', f'''SELECT m.ts, m.score, m.signals, substr(replace(p.text, char(10), ' '), 1, 100) text FROM (SELECT * FROM mood WHERE {W}) m
            JOIN prompts p USING (uuid) WHERE m.score > 0 ORDER BY m.score DESC, m.ts DESC LIMIT ?''', p + [L])
    if want('hours'):
        table(con, 'By hour of day (local)', f'''SELECT printf('%02d:00', hour) hour, COUNT(*) requests, {TOK}
            FROM requests WHERE {W} GROUP BY hour ORDER BY hour''', p)
    if want('prompts'):
        table(con, 'Prompts by kind', f'''SELECT kind, COUNT(*) n, SUM(chars) chars, ROUND(AVG(chars)) avg FROM prompts WHERE {W}
            GROUP BY kind ORDER BY chars DESC''', p)
        table(con, 'Slash commands', f'''SELECT substr(text, instr(text, '<command-name>') + 14,
              instr(text, '</command-name>') - instr(text, '<command-name>') - 14) command, COUNT(*) n
            FROM prompts WHERE {W} AND kind = 'command' GROUP BY command ORDER BY n DESC LIMIT ?''', p + [L])
    if want('dialogs'):
        # Mod dialogs have no project: filtered by day and profile only.
        DW, dp = ' AND '.join(x for x in w if not x.startswith('project')), [x for x in p if not str(x).startswith('%')]
        table(con, 'Mod dialogs by mod and profile', f'''SELECT mod, profile, SUM(kind = 'ask') questions, SUM(kind = 'ask' AND dismissed != 0) dismissed,
              SUM(kind = 'command') commands, SUM(kind = 'hold') held, SUM(kind = 'toast') toasts FROM v_dialogs WHERE {DW}
            GROUP BY 1, 2 ORDER BY COUNT(*) DESC''', dp)
        table(con, 'Mod questions and your answers', f'''SELECT mod, substr(question, 1, 80) question,
              CASE WHEN dismissed != 0 THEN '(dismissed)' ELSE answer END answer, COUNT(*) n FROM v_dialogs
            WHERE {DW} AND kind IN ('ask', 'hold_answer') GROUP BY 1, 2, 3 ORDER BY n DESC LIMIT ?''', dp + [L])
    con.close()
    return 0


def cmd_sql(args):
    con = connect()
    table(con, args.query[:80], args.query)
    return 0


def cmd_schema(args):
    con = connect()
    for name, typ in con.execute("SELECT name, type FROM sqlite_master WHERE type IN ('table','view') ORDER BY type, name"):
        cols = [r[1] for r in con.execute(f'PRAGMA table_info({name})')]
        print(f'{typ:5} {name}: {", ".join(cols)}')
    return 0


def cmd_export(args):
    con = connect()
    cur = con.execute(f'SELECT * FROM "{args.table}"')
    cols = [c[0] for c in cur.description]
    out = open(args.out, 'w', newline='') if args.out else sys.stdout
    if args.format == 'csv':
        wr = csv.writer(out)
        wr.writerow(cols)
        wr.writerows(cur)
    else:
        for r in cur:
            out.write(json.dumps(dict(zip(cols, r)), ensure_ascii=False) + '\n')
    return 0


def cmd_serve(args):
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import dashboard_api
    connect().close()  # make sure the database and views exist
    html = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'dashboard', 'index.html')

    def ingest(progress=None):
        cmd_ingest(argparse.Namespace(quiet=True, full=False, progress=progress))
    try:
        version = json.load(open(os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), '.claude-plugin', 'plugin.json')))['version']
    except (OSError, ValueError, KeyError):
        version = None
    return dashboard_api.serve(DB, html, make_coster(), ingest, port=args.port or paths.port(), open_browser=args.open,
                               daemon=args.daemon, tab=args.tab, log_path=os.path.join(DATA, 'dashboard.log'),
                               live_dir=os.path.join(DATA, 'live'), version=version, quiet=args.quiet, restart=args.restart,
                               idle_min=paths.idle_min() if args.idle_min is None else args.idle_min)


def cmd_scrub(args):
    """Blank secrets in rows ingested before redaction existed."""
    con = connect()
    targets = [('prompts', 'uuid', ['text'], False), ('tool_uses', 'id', ['cmd', 'pattern', 'detail', 'file'], False),
               ('system_events', 'uuid', ['data'], True), ('events', 'rowid', ['data'], True)]
    total = 0
    for table, key, cols, is_json in targets:
        changed = 0
        for row in con.execute(f'SELECT {key}, {", ".join(cols)} FROM {table}').fetchall():
            new = []
            for v in row[1:]:
                if is_json and v:
                    try:
                        new.append(json.dumps(scrub(json.loads(v)), ensure_ascii=False))
                        continue
                    except Exception:
                        pass
                new.append(redact(v))
            if list(row[1:]) != new and not (is_json and [json.loads(x) if x else x for x in row[1:]] == [json.loads(x) if x else x for x in new]):
                con.execute(f'UPDATE {table} SET {", ".join(c + " = ?" for c in cols)} WHERE {key} = ?', (*new, row[0]))
                changed += 1
        con.commit()
        print(f'{table:<14} {changed:>6} rows redacted')
        total += changed
    files = 0
    for path in glob.glob(os.path.join(DATA, 'events', '**', '*.jsonl'), recursive=True):
        text = open(path, encoding='utf-8').read()
        out = []
        for line in text.splitlines():
            try:
                out.append(json.dumps(scrub(json.loads(line)), ensure_ascii=False, separators=(',', ':')))
            except Exception:
                out.append(redact(line))
        new = '\n'.join(out) + '\n'
        if redact(text) != text or SECRET_KEY.search(text) and new != text:
            if [json.loads(x) for x in out if x.startswith('{')] != [json.loads(x) for x in text.splitlines() if x.startswith('{')]:
                with open(path + '.tmp', 'w', encoding='utf-8') as f:
                    f.write(new)
                os.replace(path + '.tmp', path)
                files += 1
    print(f'{"event files":<14} {files:>6} rewritten')
    if total:
        con.execute('VACUUM')  # drop the old pages that still hold the values
    return 0


def cmd_stop(args):
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import dashboard_api
    print('dashboard stopped' if dashboard_api.stop(args.port or paths.port()) else 'dashboard was not running')
    return 0


def cmd_status(args):
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import dashboard_api
    con = connect()
    one = lambda q: con.execute(q).fetchone()
    reqs, first, last = one('SELECT COUNT(*), MIN(day), MAX(day) FROM requests')
    print(f'data:      {DATA}')
    print(f'database:  {os.path.getsize(DB) / 1e6:.0f} MB · {reqs:,} requests · {first} → {last}')
    for prof, n, c in con.execute("SELECT profile, COUNT(*), ROUND(SUM(cost_usd), 2) FROM requests GROUP BY 1 ORDER BY 3 DESC"):
        print(f'           {prof:<14} {n:>8,} requests  ${c or 0:,.2f}')
    ing = one("SELECT MAX(ingested_at) FROM files")[0] if one("SELECT 1 FROM sqlite_master WHERE name = 'files'") else None
    print(f'ingested:  {ing or "?"}')
    for mod, n, last_ in con.execute("SELECT json_extract(data,'$.mod'), COUNT(*), MAX(day) FROM events WHERE ev = 'mod' GROUP BY 1"):
        print(f'mod events: {mod:<14} {n:>7,}  last {last_}')
    port = paths.port()
    p = dashboard_api.ping(port)
    print('dashboard: ' + (f'running on http://127.0.0.1:{port}/ (version {p.get("version") or "?"}, pid {p.get("pid")}, live updates on)' if p else 'stopped (claude-usage serve --daemon --open)'))
    print(f'autostart: {autostart_state()}')
    return 0


def cmd_setup(args):
    """Everything the setup wizard asks about, detected: which profiles have history, how far back, and what runs."""
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import dashboard_api
    cfg = paths.config()
    known = {}
    if os.path.exists(DB):
        con = connect()
        known = {r[0]: r[1:] for r in con.execute(
            "SELECT profile, COUNT(*), MIN(day), MAX(day), ROUND(SUM(cost_usd), 2) FROM requests GROUP BY 1")}
        con.close()
    profiles = []
    for d in sorted(set(profile_dirs({})) | set(profile_dirs(cfg))):
        files, oldest, size = 0, None, 0
        for dirpath, _, fns in os.walk(os.path.join(d, 'projects')):
            for fn in fns:
                if fn.endswith('.jsonl'):
                    try:
                        st = os.stat(os.path.join(dirpath, fn))
                    except OSError:
                        continue
                    files += 1
                    size += st.st_size
                    oldest = st.st_mtime if oldest is None else min(oldest, st.st_mtime)
        name = os.path.basename(d.rstrip('/')).lstrip('.')
        settings = {}
        try:
            settings = json.load(open(os.path.join(d, 'settings.json')))
        except (OSError, ValueError):
            pass
        k = known.get(name)
        profiles.append({
            'profile': name, 'dir': d, 'included': d in profile_dirs(cfg), 'transcripts': files, 'mb': round(size / 1e6, 1),
            'oldestOnDisk': datetime.fromtimestamp(oldest).date().isoformat() if oldest else None,
            'cleanupPeriodDays': settings.get('cleanupPeriodDays', 30),
            'inDatabase': {'requests': k[0], 'from': k[1], 'to': k[2], 'cost': k[3]} if k else None,
        })
    port = paths.port()
    p = dashboard_api.ping(port)
    out = {
        'data': DATA, 'modsHome': paths.mods_home(), 'python': sys.version.split()[0], 'config': cfg,
        'profiles': profiles,
        'dashboard': {'port': port, 'running': bool(p), 'version': p.get('version') if p else None,
                      'autostartAtLogin': autostart_state()},
    }
    if args.json:
        print(json.dumps(out, indent=1))
        return 0
    print(f'data:      {DATA}')
    print(f'python:    {out["python"]}')
    for x in profiles:
        db = x['inDatabase']
        print(f'profile:   {x["profile"]:<16} {x["dir"]}  {"included" if x["included"] else "EXCLUDED"}  '
              f'{x["transcripts"]} transcripts ({x["mb"]} MB) since {x["oldestOnDisk"] or "-"}, kept {x["cleanupPeriodDays"]} days; '
              + (f'in database {db["requests"]:,} requests {db["from"]} → {db["to"]}' if db else 'not in the database yet'))
    print(f'dashboard: http://127.0.0.1:{port}/ ' + ('running' if p else 'stopped') + f'; at login: {out["dashboard"]["autostartAtLogin"]}')
    return 0


LABEL = 'dev.claude-mods.usage-dashboard'


def _cli_version(cli):
    try:
        with open(os.path.join(os.path.dirname(os.path.dirname(cli)), '.claude-plugin', 'plugin.json')) as f:
            return json.load(f)['version']
    except (OSError, ValueError, KeyError, TypeError):
        return None


def _vt(v):
    return tuple(int(x) for x in re.findall(r'\d+', v or '0'))


def _claim_cli_path():
    """Point cli-path at this copy unless it names a newer one that still exists (never downgrade: a profile not
    yet restarted after an update must not send the login item back to its older copy)."""
    me = os.path.realpath(__file__)
    path = os.path.join(DATA, 'cli-path')
    try:
        cur = open(path).read().strip()
    except OSError:
        cur = ''
    if cur and cur != me and os.path.isfile(cur) and _vt(_cli_version(cur)) > _vt(_cli_version(me)):
        return cur
    if cur != me:
        os.makedirs(DATA, exist_ok=True)
        with open(path + '.tmp', 'w') as f:
            f.write(me)
        os.replace(path + '.tmp', path)
    return me


def _shim():
    """A stable launcher in the data dir that runs the newest installed copy of this CLI (plugin updates move it)."""
    path = os.path.join(DATA, 'bin', 'claude-usage')
    os.makedirs(os.path.dirname(path), exist_ok=True)
    me = os.path.realpath(__file__)
    text = f"""#!/bin/sh
# Written by `claude-usage autostart on`: runs the newest installed claude-usage (the mod updates cli-path).
cli=$(cat "{DATA}/cli-path" 2>/dev/null)
[ -f "$cli" ] || cli="{me}"
exec python3 "$cli" "$@"
"""
    try:
        same = open(path).read() == text
    except OSError:
        same = False
    if not same:
        with open(path, 'w') as f:
            f.write(text)
    os.chmod(path, 0o755)
    _claim_cli_path()
    return path


def _unit_paths():
    if sys.platform == 'darwin':
        return os.path.join(HOME, 'Library', 'LaunchAgents', f'{LABEL}.plist')
    return os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.join(HOME, '.config'), 'systemd', 'user', 'claude-usage-dashboard.service')


def autostart_state():
    return 'on' if os.path.exists(_unit_paths()) else 'off'


def cmd_autostart(args):
    """`serve --daemon --quiet` at login and every 10 minutes: idempotent, so it only starts one when none runs."""
    import subprocess
    unit = _unit_paths()
    if args.state == 'status':
        print(autostart_state())
        return 0
    if args.state == 'off':
        if sys.platform == 'darwin':
            subprocess.run(['launchctl', 'unload', unit], capture_output=True)
        else:
            subprocess.run(['systemctl', '--user', 'disable', '--now', 'claude-usage-dashboard.timer'], capture_output=True)
            timer = unit[:-len('.service')] + '.timer'
            if os.path.exists(timer):
                os.remove(timer)
        if os.path.exists(unit):
            os.remove(unit)
        print('autostart off')
        return 0
    if args.state == 'sync':
        # Keep an installed login item on the current launcher and unit text; nothing to do when it is off.
        _claim_cli_path()
        if not os.path.exists(unit):
            return 0
        shim = _shim()
        try:
            same = open(unit).read() == _unit_text(shim)
        except OSError:
            same = False
        if same:
            return 0
    shim = _shim()
    os.makedirs(os.path.dirname(unit), exist_ok=True)
    if sys.platform == 'darwin':
        with open(unit, 'w') as f:
            f.write(_unit_text(shim))
        subprocess.run(['launchctl', 'unload', unit], capture_output=True)
        r = subprocess.run(['launchctl', 'load', unit], capture_output=True, text=True)
    else:
        with open(unit, 'w') as f:
            f.write(_unit_text(shim))
        with open(unit[:-len('.service')] + '.timer', 'w') as f:
            f.write("""[Unit]
Description=keep the claude-usage dashboard running

[Timer]
OnStartupSec=10
OnUnitActiveSec=600

[Install]
WantedBy=timers.target
""")
        subprocess.run(['systemctl', '--user', 'daemon-reload'], capture_output=True)
        r = subprocess.run(['systemctl', '--user', 'enable', '--now', 'claude-usage-dashboard.timer'], capture_output=True, text=True)
    if r.returncode != 0:
        print(f'autostart written to {unit}, but loading it failed: {(r.stderr or r.stdout).strip()}')
        return 1
    if args.state == 'sync':
        print(f'autostart refreshed ({unit})')
        return 0
    print(f'autostart on: the dashboard starts at login and is checked every 10 minutes ({unit})')
    return 0


def _unit_text(shim):
    if sys.platform == 'darwin':
        return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{LABEL}</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>{shim}</string><string>serve</string><string>--daemon</string><string>--quiet</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>600</integer>
  <key>EnvironmentVariables</key><dict><key>CLAUDE_USAGE_DIR</key><string>{DATA}</string><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
</dict></plist>
"""
    return f"""[Unit]
Description=claude-usage dashboard (starts one if none runs)

[Service]
Type=oneshot
Environment=CLAUDE_USAGE_DIR={DATA}
ExecStart=/bin/sh {shim} serve --daemon --quiet
"""


def cmd_impact(args):
    if args.ingest:
        cmd_ingest(argparse.Namespace(quiet=True, full=False))
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import impact
    con = connect()
    r = impact.impact(con, make_coster(), days=args.days, profiles=[args.profile] if args.profile else None)
    print(json.dumps(r, default=str, indent=1) if args.json else impact.fmt_text(r))
    return 0


def _summary_mod():
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import summary
    return summary


def cmd_digest(args):
    """Last week against the week before: the weekly toast (--line) or a short report."""
    if args.ingest:
        cmd_ingest(argparse.Namespace(quiet=True, full=False))
    summary = _summary_mod()
    import advisor
    con = connect()
    try:
        new = [r for r in advisor.recs(advisor.adb(DATA)) if r.get('status') == 'proposed']
    except Exception:  # the advisor is optional here
        new = []
    d = summary.digest(con, new_recs=new)
    print(json.dumps(d, default=str, indent=1) if args.json else summary.fmt_digest_line(d) if args.line else summary.fmt_digest(d))
    return 0


def cmd_summary(args):
    """A shareable summary of the last N days: Markdown or a self-contained HTML page, saved to a file."""
    if args.ingest:
        cmd_ingest(argparse.Namespace(quiet=True, full=False))
    summary = _summary_mod()
    import impact
    con = connect()
    try:
        imp = impact.impact(con, make_coster(), days=args.days)
    except Exception:  # no mod events yet
        imp = None
    s = summary.summary(con, days=args.days, projects=not args.no_projects, impact=imp)
    text = summary.to_html(s) if args.format == 'html' else summary.to_md(s)
    if args.out == '-':
        sys.stdout.write(text)
        return 0
    out = args.out or os.path.join(DATA, 'summaries', f"usage-{s['from']}-to-{s['to']}.{'html' if args.format == 'html' else 'md'}")
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    with open(out, 'w') as f:
        f.write(text)
    print(out)
    return 0


def cmd_recurring(args):
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import recurring
    if args.ingest:
        cmd_ingest(argparse.Namespace(quiet=True, full=False))
    con = connect()
    a = recurring.adb(DATA)
    profiles = [x if x.startswith('claude') else f'claude-{x}' for x in args.profile.split(',')] if args.profile else None
    kw = dict(days=args.days, profiles=profiles, project=args.project, min_count=args.min, min_days=args.min_days,
              threshold=args.threshold, redact=redact, headless=args.headless)
    out = lambda d: print(json.dumps(d, default=str, indent=1))
    act, rest = args.action, args.rest
    if act == 'show' and rest:
        c = recurring._find(con, a, rest[0], **kw)
        if not c:
            print(f'no recurring ask {rest[0]}', file=sys.stderr)
            return 1
        out(c) if args.json else print(recurring.fmt_one(c))
    elif act == 'show':
        r = recurring.report(con, a, **kw)
        out(r) if args.json else print(recurring.fmt_text(r, args.limit))
    elif act == 'brief':
        out(recurring.brief(con, a, limit=args.limit, relabel=args.relabel, **kw))
    elif act == 'record':
        src = rest[0] if rest else '-'
        payload = json.load(sys.stdin if src == '-' else open(src))
        rid, done, warn = recurring.record(con, a, payload, model=args.model, **kw)
        print(f'run {rid}: {len(done)} ask(s) labelled ({", ".join(done) or "none"})')
        for w in warn:
            print(f'  ! {w}')
    elif act == 'set':
        if len(rest) < 2:
            print('usage: recurring set ID automated|dismissed|new [--note TEXT] [--at ISO]', file=sys.stderr)
            return 2
        try:
            r = recurring.set_status(con, a, rest[0], rest[1], note=args.note, at=args.at, **kw)
        except ValueError as ex:
            print(ex, file=sys.stderr)
            return 1
        print(f"{r['id']} is now {r['status']}: {r['exemplar']}")
    return 0


def cmd_advise(args):
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import advisor
    if args.ingest:
        cmd_ingest(argparse.Namespace(quiet=True, full=False))
    con = connect()
    a = advisor.adb(DATA)
    profiles = args.profile.split(',') if args.profile else None
    out = lambda d: print(json.dumps(d, default=str, indent=1))
    act, rest = args.action, args.rest
    if act == 'show':
        d = advisor.dashboard(con, a, profiles, args.days)
        out(d) if args.json else print(advisor.fmt_text(d))
    elif act == 'brief':
        out(advisor.brief(con, a, profiles, args.days))
    elif act == 'record':
        src = rest[0] if rest else '-'
        payload = json.load(sys.stdin if src == '-' else open(src))
        rid, added, skipped, warnings = advisor.record(con, a, payload, trigger=args.trigger, model=args.model, run_id=args.run)
        print(f'run {rid}: {len(added)} recommendation(s) recorded ({", ".join(added) or "none"})'
              + (f'; skipped as already open: {"; ".join(skipped)}' if skipped else ''))
        for r in advisor.recs(a):
            if r['id'] in added:
                pw, imp = r['power'] or {}, r['impact'] or {}
                print(f"  {r['id']} [grade {r['grade']}] {r['title']}"
                      + (f"; worth ~${imp['usd_month']:.0f}/month" if imp.get('usd_month') else '')
                      + (f"; a verdict needs ~{pw['after']} sessions after (~{pw['after_days']} days)" if pw.get('after') else '')
                      + (f"; an A/B trial ~{pw['trial']} sessions" if r['instruction'] and pw.get('trial') else ''))
                for w in warnings.get(r['id'], []):
                    print(f'    ! {w}')
    elif act == 'set':
        if len(rest) < 2:
            print('usage: advise set ID proposed|accepted|trial|applied|dismissed|reverted [--note TEXT] [--at ISO]', file=sys.stderr)
            return 2
        try:
            r = advisor.set_status(con, a, rest[0], rest[1], note=args.note, at=args.at)
        except ValueError as ex:
            print(ex, file=sys.stderr)
            return 1
        if r['status'] == 'trial':
            print(f"{r['id']} is on trial: {r['title']}. From the next session on, a random half of sessions get the instruction; "
                  f"the two halves are compared on {advisor.M[r['metric']][1]} and the guard metrics.")
        else:
            print(f"{r['id']} is {r['status']}: {r['title']}" + (f" (baseline {advisor.fmt_value(r['metric'], r['baseline'])} {advisor.M[r['metric']][1]}; "
                  f"verdict after {advisor.MIN_AFTER}+ sessions)" if r['status'] == 'applied' and r['metric'] in advisor.M else '')
                  + (f"; {round(100 * advisor.HOLDOUT)}% of sessions stay without it, so its effect keeps being measured" if r['status'] == 'applied' and r['instruction'] else ''))
    elif act == 'due':
        out(advisor.due(a, args.every, claim=args.claim, trigger=args.trigger, model=args.model, data_dir=DATA))
    elif act == 'fail':
        a.execute("UPDATE runs SET status = 'failed', finished = ?, summary = ? WHERE id = ?", (advisor.now_iso(), ' '.join(rest[1:])[:500] or None, rest[0] if rest else ''))
        a.commit()
    elif act == 'notify':
        out(advisor.notify(con, a))
    elif act == 'reproduce':
        try:
            out(advisor.reproduce(con, a, rest[0] if rest else ''))
        except ValueError as ex:
            print(ex, file=sys.stderr)
            return 1
    elif act == 'get':
        r = [x for x in advisor.recs(a) if x['id'] == (rest[0] if rest else '')]
        if not r:
            print(f'no recommendation {rest[0] if rest else ""}', file=sys.stderr)
            return 1
        out(r[0])
    elif act == 'sql':
        # Read-only, for the advisor agent: its own connection cannot write.
        ro = advisor.readonly(DB)
        try:
            cur = ro.execute(' '.join(rest))
            rows = cur.fetchmany(args.limit)
        except sqlite3.Error as ex:
            out({'error': str(ex)})
            return 1
        out({'cols': [c[0] for c in cur.description or []], 'rows': rows, 'truncated': len(rows) == args.limit})
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog='claude-usage', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd')
    a = sub.add_parser('ingest'); a.add_argument('--quiet', action='store_true'); a.add_argument('--full', action='store_true')
    a.set_defaults(fn=cmd_ingest)
    r = sub.add_parser('report')
    r.add_argument('what', nargs='?', default='overview',
                   choices=['overview', 'profiles', 'daily', 'models', 'projects', 'tools', 'bash', 'files', 'agents',
                            'sessions', 'context', 'hours', 'cache', 'prompts', 'dialogs', 'gateway', 'quality', 'frustration', 'all'])
    r.add_argument('--days', type=int, default=30, help='0 = all time')
    r.add_argument('--profile'); r.add_argument('--project'); r.add_argument('--limit', type=int, default=15)
    r.add_argument('--ingest', action='store_true', help='ingest new data first')
    r.set_defaults(fn=cmd_report)
    s = sub.add_parser('sql'); s.add_argument('query'); s.set_defaults(fn=cmd_sql)
    sub.add_parser('schema').set_defaults(fn=cmd_schema)
    e = sub.add_parser('export'); e.add_argument('table'); e.add_argument('--format', choices=['csv', 'jsonl'], default='csv')
    e.add_argument('--out'); e.set_defaults(fn=cmd_export)
    sub.add_parser('reprice').set_defaults(fn=cmd_reprice)
    v = sub.add_parser('serve', help='the dashboard on http://127.0.0.1:PORT/')
    v.add_argument('--port', type=int, help='default: "port" in config.json, else 8787'); v.add_argument('--open', action='store_true')
    v.add_argument('--daemon', action='store_true', help='run in the background'); v.set_defaults(fn=cmd_serve)
    v.add_argument('--tab', help='open the dashboard on this tab, e.g. impact')
    v.add_argument('--quiet', action='store_true', help='print nothing (used by the mod to start it at session start)')
    v.add_argument('--restart', action='store_true', help='stop a running dashboard first and start a fresh one')
    v.add_argument('--idle-min', type=int, help='close after this many minutes with no page open (default: "dashboardIdleMin" in config.json, else 60; 0 = never)')
    m = sub.add_parser('impact', help='is each mod saving money or costing more (holdout comparison + ledger)')
    m.add_argument('--days', type=int, default=30, help='0 = all time'); m.add_argument('--profile')
    m.add_argument('--json', action='store_true'); m.add_argument('--ingest', action='store_true'); m.set_defaults(fn=cmd_impact)
    st = sub.add_parser('stop', help='stop the background dashboard'); st.add_argument('--port', type=int)
    st.set_defaults(fn=cmd_stop)
    sub.add_parser('scrub', help='blank secrets in rows already in the database').set_defaults(fn=cmd_scrub)
    sub.add_parser('status', help='data, ingest and dashboard status').set_defaults(fn=cmd_status)
    su = sub.add_parser('setup', help='what the setup wizard needs to know: profiles, history on disk, dashboard')
    su.add_argument('--json', action='store_true'); su.set_defaults(fn=cmd_setup)
    au = sub.add_parser('autostart', help='keep the dashboard running from login too')
    au.add_argument('state', choices=['on', 'off', 'status', 'sync']); au.set_defaults(fn=cmd_autostart)
    sub.add_parser('path').set_defaults(fn=lambda a: print(DATA) or 0)
    dg = sub.add_parser('digest', help='last week against the week before (the weekly toast)')
    dg.add_argument('--json', action='store_true'); dg.add_argument('--line', action='store_true', help='one line, for a toast')
    dg.add_argument('--ingest', action='store_true'); dg.set_defaults(fn=cmd_digest)
    sm = sub.add_parser('summary', help='a shareable summary (md or html), saved under <data>/summaries/ unless --out')
    sm.add_argument('--days', type=int, default=30); sm.add_argument('--format', choices=['md', 'html'], default='md')
    sm.add_argument('--out', help='file to write, - for stdout'); sm.add_argument('--no-projects', action='store_true', help='leave project names out')
    sm.add_argument('--ingest', action='store_true'); sm.set_defaults(fn=cmd_summary)
    ad = sub.add_parser('advise', help='the self-improving advisor (show, brief, record, set, due, notify)')
    ad.add_argument('action', nargs='?', default='show', choices=['show', 'brief', 'record', 'set', 'get', 'due', 'fail', 'notify', 'sql', 'reproduce'])
    ad.add_argument('--limit', type=int, default=200, help='sql: most rows returned')
    ad.add_argument('rest', nargs='*')
    ad.add_argument('--days', type=int, default=30); ad.add_argument('--profile'); ad.add_argument('--json', action='store_true')
    ad.add_argument('--ingest', action='store_true'); ad.add_argument('--note'); ad.add_argument('--at', help='when it was applied (ISO time)')
    ad.add_argument('--every', type=float, default=7, help='due: days between research runs'); ad.add_argument('--claim', action='store_true')
    ad.add_argument('--trigger', default='manual'); ad.add_argument('--model'); ad.add_argument('--run', help='record: the run id from `due --claim`')
    ad.set_defaults(fn=cmd_advise)
    rc = sub.add_parser('recurring', help='recurring asks: prompts you keep typing (show, brief, record, set)')
    rc.add_argument('action', nargs='?', default='show', choices=['show', 'brief', 'record', 'set'])
    rc.add_argument('rest', nargs='*')
    rc.add_argument('--days', type=int, default=90); rc.add_argument('--profile'); rc.add_argument('--project')
    rc.add_argument('--min', type=int, default=3, help='prompts an ask needs'); rc.add_argument('--min-days', type=int, default=2)
    rc.add_argument('--threshold', type=float, default=0.55, help='overlap (0-1) for two prompts to be one ask')
    rc.add_argument('--limit', type=int, default=15); rc.add_argument('--json', action='store_true'); rc.add_argument('--relabel', action='store_true')
    rc.add_argument('--headless', action='store_true', help='also count prompts of claude -p / SDK runs (left out: they are automated already)')
    rc.add_argument('--ingest', action='store_true'); rc.add_argument('--note'); rc.add_argument('--at'); rc.add_argument('--model')
    rc.set_defaults(fn=cmd_recurring)
    args = ap.parse_args(argv)
    if not getattr(args, 'fn', None):
        ap.print_help()
        return 0
    return args.fn(args)


if __name__ == '__main__':
    sys.exit(main())
