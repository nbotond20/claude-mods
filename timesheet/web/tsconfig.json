{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client", "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@loam/ui-web": [
        "../../loam/packages/ui-web/src/index.ts"
      ],
      "@loam/theme-web": [
        "../../loam/packages/theme-web/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}